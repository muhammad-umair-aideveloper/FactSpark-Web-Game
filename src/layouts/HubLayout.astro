---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StructuredData from '../components/StructuredData.astro';
import type { GameData } from '../schema/gameSchema';

interface Props {
  title: string;
  metaDescription: string;
  h1: string;
  intro: string;
  canonicalUrl: string;
  games: GameData[];
  breadcrumbs: Array<{ name: string; url: string }>;
}

const {
  title,
  metaDescription,
  h1,
  intro,
  canonicalUrl,
  games,
  breadcrumbs
} = Astro.props;
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <StructuredData
    slot="head"
    canonicalUrl={canonicalUrl}
    breadcrumbs={breadcrumbs}
  />

  <Breadcrumbs crumbs={breadcrumbs} />

  <header class="hub-header">
    <div class="hub-count-badge">
      <span class="hub-sparkle" aria-hidden="true">&#10024;</span>
      <span>{games.length} Interactive Fluency Challenges</span>
    </div>
    <h1 class="hub-title">{h1}</h1>
    <p class="hub-intro">{intro}</p>
  </header>

  <section class="hub-games-grid">
    {games.map((game) => (
      <a href={`/math/${game.slug}/`} class="hub-card">
        <div class="card-top">
          <span class="card-grade">Grade {game.grade}</span>
          <span class="card-sec">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {game.game.seconds}s
          </span>
        </div>
        <h2 class="card-heading">{game.seo.h1}</h2>
        <p class="card-prompt">{game.game.prompt}</p>
        <div class="card-bottom">
          <span class="card-domain">{game.topic.replace('-', ' ')}</span>
          <span class="card-cta">
            <span>Play Quest</span>
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .hub-header {
    text-align: center;
    max-width: 820px;
    margin: 1.5rem auto 3rem;
  }
  .hub-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #FFFFFF;
    color: #07006C;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    font-family: var(--font-caps);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hub-sparkle {
    color: #FFC329;
  }
  .hub-title {
    font-family: var(--font-heading);
    font-size: 2.85rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 1rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .hub-intro {
    font-size: 1.2rem;
    color: #464554;
    line-height: 1.65;
    margin: 0 auto;
    font-weight: 500;
  }

  .hub-games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  /* Tactile Neo-Brutalist Arcade Cards */
  .hub-card {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 20px;
    box-shadow: 0 6px 0 0 #0F172A;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    overflow: hidden;
  }
  .hub-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 7px;
    background: #4648D4;
    border-bottom: 2px solid #0F172A;
  }
  .hub-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 0 0 #0F172A;
  }
  .hub-card:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 0 #0F172A;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    padding-top: 0.25rem;
  }
  .card-grade {
    background: #E1E0FF;
    color: #07006C;
    border: 1.5px solid #0F172A;
    font-family: var(--font-caps);
    font-size: 0.775rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
  }
  .card-sec {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFDF9F;
    color: #6F5100;
    border: 1.5px solid #0F172A;
    border-radius: 9999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.775rem;
    font-family: var(--font-caps);
    font-weight: 700;
  }

  .card-heading {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 0.5rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .card-prompt {
    font-size: 0.95rem;
    color: #464554;
    margin: 0 0 1.25rem;
    flex-grow: 1;
    line-height: 1.5;
    font-weight: 500;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed #C7C4D7;
    padding-top: 0.85rem;
    font-size: 0.85rem;
  }
  .card-domain {
    text-transform: capitalize;
    color: #464554;
    font-weight: 700;
    font-size: 0.825rem;
    font-family: var(--font-caps);
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #22C55E;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.825rem;
    padding: 0.4rem 1rem;
    border: 2px solid #0F172A;
    border-radius: 12px;
    box-shadow: 0 3px 0 0 #15803D;
    transition: transform 0.08s ease, background-color 0.1s ease;
  }
  .hub-card:hover .card-cta {
    background: #16A34A;
    transform: scale(1.04);
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .hub-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hub-title { font-size: 2rem; }
    .hub-intro { font-size: 1.05rem; }
  }
</style>
