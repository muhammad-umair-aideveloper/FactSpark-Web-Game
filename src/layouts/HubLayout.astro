---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StructuredData from '../components/StructuredData.astro';
import type { GameData } from '../schema/gameSchema';

interface Props {
  title: string;
  metaDescription: string;
  h1: string;
  intro: string;
  canonicalUrl: string;
  games: GameData[];
  breadcrumbs: Array<{ name: string; url: string }>;
}

const {
  title,
  metaDescription,
  h1,
  intro,
  canonicalUrl,
  games,
  breadcrumbs
} = Astro.props;
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <StructuredData
    slot="head"
    canonicalUrl={canonicalUrl}
    breadcrumbs={breadcrumbs}
  />

  <Breadcrumbs crumbs={breadcrumbs} />

  <header class="hub-header">
    <div class="hub-count-badge">
      <span class="hub-sparkle" aria-hidden="true">&#10024;</span>
      <span>{games.length} Interactive Fluency Challenges</span>
    </div>
    <h1 class="hub-title">{h1}</h1>
    <p class="hub-intro">{intro}</p>
  </header>

  <section class="hub-games-grid">
    {games.map((game) => (
      <a href={`/math/${game.slug}/`} class="hub-card">
        <div class="card-top">
          <span class="card-grade">Grade {game.grade}</span>
          <span class="card-sec">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {game.game.seconds}s
          </span>
        </div>
        <h2 class="card-heading">{game.seo.h1}</h2>
        <p class="card-prompt">{game.game.prompt}</p>
        <div class="card-bottom">
          <span class="card-domain">{game.topic.replace('-', ' ')}</span>
          <span class="card-cta">
            <span>Play Quest</span>
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .hub-header {
    text-align: center;
    max-width: 820px;
    margin: 1.5rem auto 3rem;
  }
  .hub-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #1E1B4B;
    color: #BAE6FD;
    border: 2px solid #38BDF8;
    border-bottom: 4px solid #0369A1;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    margin-bottom: 1rem;
  }
  .hub-sparkle {
    color: #F59E0B;
  }
  .hub-title {
    font-family: var(--font-heading);
    font-size: 2.85rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 1rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .hub-intro {
    font-size: 1.2rem;
    color: #CBD5E1;
    line-height: 1.65;
    margin: 0 auto;
    font-weight: 600;
  }

  .hub-games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  /* Collectible Arcade Cards */
  .hub-card {
    background: #0F172A;
    border: 2px solid #312E81;
    border-bottom: 6px solid #1E1B4B;
    border-radius: 20px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.12s ease, border-bottom-width 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    overflow: hidden;
  }
  .hub-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #6366F1, #EC4899, #FACC15);
  }
  .hub-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 14px 28px rgba(99, 102, 241, 0.3);
    border-color: #6366F1;
    border-bottom-width: 8px;
  }
  .hub-card:active {
    transform: translateY(3px);
    border-bottom-width: 2px !important;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .card-grade {
    background: #312E81;
    color: #C7D2FE;
    border: 2px solid #6366F1;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
  }
  .card-sec {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #451A03;
    color: #FDBA74;
    border: 2px solid #F97316;
    border-radius: 9999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    font-family: var(--font-heading);
    font-weight: 800;
  }

  .card-heading {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .card-prompt {
    font-size: 0.95rem;
    color: #94A3B8;
    margin: 0 0 1.25rem;
    flex-grow: 1;
    line-height: 1.5;
    font-weight: 600;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed #1E293B;
    padding-top: 0.85rem;
    font-size: 0.85rem;
  }
  .card-domain {
    text-transform: capitalize;
    color: #A5B4FC;
    font-weight: 800;
    font-size: 0.825rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #6366F1;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.825rem;
    padding: 0.35rem 0.95rem;
    border: 2px solid #818CF8;
    border-bottom: 4px solid #3730A3;
    border-radius: 9999px;
    transition: transform 0.08s ease, border-bottom-width 0.08s ease;
  }
  .hub-card:hover .card-cta {
    background: #4F46E5;
    transform: scale(1.05);
  }
    background: #4F46E5;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 3px 0 #3730A3;
    transition: transform 0.15s ease, background-color 0.15s;
  }
  .hub-card:hover .card-cta {
    background: #4338CA;
    transform: scale(1.05);
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .hub-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hub-title { font-size: 2rem; }
    .hub-intro { font-size: 1.05rem; }
  }
</style>
