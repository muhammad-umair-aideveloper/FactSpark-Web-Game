---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StructuredData from '../components/StructuredData.astro';
import type { GameData } from '../schema/gameSchema';

interface Props {
  title: string;
  metaDescription: string;
  h1: string;
  intro: string;
  canonicalUrl: string;
  games: GameData[];
  breadcrumbs: Array<{ name: string; url: string }>;
}

const {
  title,
  metaDescription,
  h1,
  intro,
  canonicalUrl,
  games,
  breadcrumbs
} = Astro.props;
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <StructuredData
    slot="head"
    canonicalUrl={canonicalUrl}
    breadcrumbs={breadcrumbs}
  />

  <Breadcrumbs crumbs={breadcrumbs} />

  <header class="hub-header">
    <div class="hub-count-badge">
      <span class="hub-sparkle" aria-hidden="true">&#10024;</span>
      <span>{games.length} Interactive Fluency Challenges</span>
    </div>
    <h1 class="hub-title">{h1}</h1>
    <p class="hub-intro">{intro}</p>
  </header>

  <section class="hub-games-grid">
    {games.map((game) => (
      <a href={`/math/${game.slug}/`} class="hub-card">
        <div class="card-top">
          <span class="card-grade">Grade {game.grade}</span>
          <span class="card-sec">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            {game.game.seconds}s
          </span>
        </div>
        <h2 class="card-heading">{game.seo.h1}</h2>
        <p class="card-prompt">{game.game.prompt}</p>
        <div class="card-bottom">
          <span class="card-domain">{game.topic.replace('-', ' ')}</span>
          <span class="card-cta">
            <span>Play Quest</span>
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .hub-header {
    text-align: center;
    max-width: 820px;
    margin: 1.5rem auto 3rem;
  }
  .hub-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #EEF2FF;
    color: #4338CA;
    border: 2px solid #C7D2FE;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 3px 0 #C7D2FE;
    margin-bottom: 1rem;
  }
  .hub-sparkle {
    color: #F59E0B;
  }
  .hub-title {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 1rem;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .hub-intro {
    font-size: 1.15rem;
    color: #475569;
    line-height: 1.65;
    margin: 0 auto;
    font-weight: 600;
  }

  .hub-games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  
  /* Bouncy Quest Cards */
  .hub-card {
    background: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: var(--card-radius);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 6px 0 #E2E8F0, 0 12px 20px -4px rgba(15, 23, 42, 0.05);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .hub-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 10px 0 #C7D2FE, 0 18px 28px -4px rgba(99, 102, 241, 0.18);
    border-color: #818CF8;
  }
  .hub-card:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #C7D2FE;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .card-grade {
    background: #EEF2FF;
    color: #4F46E5;
    border: 1.5px solid #C7D2FE;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
  }
  .card-sec {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: #FFF7ED;
    color: #EA580C;
    border: 1.5px solid #FED7AA;
    border-radius: 9999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.8rem;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .card-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .card-prompt {
    font-size: 0.925rem;
    color: #64748B;
    margin: 0 0 1.25rem;
    flex-grow: 1;
    line-height: 1.5;
    font-weight: 600;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px dashed #F1F5F9;
    padding-top: 0.85rem;
    font-size: 0.85rem;
  }
  .card-domain {
    text-transform: capitalize;
    color: #64748B;
    font-weight: 700;
    font-size: 0.825rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #4F46E5;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 3px 0 #3730A3;
    transition: transform 0.15s ease, background-color 0.15s;
  }
  .hub-card:hover .card-cta {
    background: #4338CA;
    transform: scale(1.05);
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .hub-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hub-title { font-size: 2rem; }
    .hub-intro { font-size: 1.05rem; }
  }
</style>
