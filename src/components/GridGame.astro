---
import type { GameData } from '../schema/gameSchema';
import { generatePoolItems, resolveTargetIds } from '../schema/gameSchema';

interface Props {
  game: GameData;
}

const { game } = Astro.props;

const items = generatePoolItems(game.game.pool, game.game.display);
const targetIds = resolveTargetIds(game);
---

<div class="game-wrapper" id="game-app" data-slug={game.slug} data-seconds={game.game.seconds} data-targets={JSON.stringify(targetIds)}>
  <!-- Header Bar: Prompt and Controls -->
  <div class="game-header-card">
    <div class="prompt-section">
      <span class="prompt-badge">Current Target</span>
      <h2 class="prompt-title" id="game-prompt">{game.game.prompt}</h2>
    </div>

    <div class="game-controls">
      <button type="button" class="ctrl-btn" id="btn-projector" title="Toggle Big Tile Projector Mode" aria-pressed="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
        <span>Projector</span>
      </button>

      <button type="button" class="ctrl-btn" id="btn-sound" title="Toggle Sound Effects" aria-pressed="false">
        <svg class="icon-sound-on" style="display:none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        <svg class="icon-sound-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        <span>Sound</span>
      </button>

      {game.game.allowShuffle && (
        <button type="button" class="ctrl-btn" id="btn-shuffle" title="Shuffle Tiles (Hard Mode)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
          <span>Shuffle</span>
        </button>
      )}

      <button type="button" class="ctrl-btn reset-btn" id="btn-reset" title="Restart Round">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
        <span>Reset</span>
      </button>
    </div>
  </div>

  <!-- Telemetry Bar -->
  <div class="telemetry-bar" aria-live="polite" role="status">
    <div class="metric-item timer-metric">
      <span class="metric-label">Time Remaining</span>
      <span class="metric-val" id="metric-timer">{game.game.seconds}.0s</span>
    </div>

    <div class="metric-item targets-metric">
      <span class="metric-label">Targets Remaining</span>
      <span class="metric-val" id="metric-remaining">{targetIds.length}</span>
    </div>

    <div class="metric-item score-metric">
      <span class="metric-label">Score</span>
      <span class="metric-val" id="metric-score">0</span>
    </div>

    <div class="metric-item accuracy-metric">
      <span class="metric-label">Accuracy</span>
      <span class="metric-val" id="metric-accuracy">0%</span>
    </div>

    <div class="metric-item pb-metric">
      <span class="metric-label">Personal Best</span>
      <span class="metric-val" id="metric-pb">--</span>
    </div>
  </div>

  <!-- 10x10 Interactive Grid -->
  <div class="grid-container" id="grid-board" role="grid" aria-label="Math fact tiles 10 by 10 grid">
    {items.map((item, index) => (
      <button
        type="button"
        class="grid-tile"
        data-tile-id={item.id}
        data-index={index}
        aria-label={`Tile ${item.display}`}
        tabindex="0"
      >
        <span class="tile-val">{item.display}</span>
        <span class="tile-icon icon-check" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </span>
        <span class="tile-icon icon-cross" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </span>
      </button>
    ))}
  </div>

  <!-- Screen reader live announcer for time penalties and round results -->
  <div class="sr-only" aria-live="assertive" aria-atomic="true" id="game-announcer"></div>

  <!-- Round End Modal Overlay -->
  <div class="round-modal-backdrop" id="end-modal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="round-modal-card">
      <div class="stars-row" id="modal-stars" aria-label="0 out of 3 stars">
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
        <span class="star-icon">&#9733;</span>
      </div>

      <h3 class="modal-title" id="modal-title">Round Complete!</h3>
      <p class="modal-subtitle" id="modal-sub">You identified all target tiles.</p>

      <div class="modal-stats-grid">
        <div class="mstat"><span class="mstat-lbl">Final Score</span><strong id="modal-final-score">0</strong></div>
        <div class="mstat"><span class="mstat-lbl">Accuracy</span><strong id="modal-final-accuracy">0%</strong></div>
        <div class="mstat"><span class="mstat-lbl">Time Elapsed</span><strong id="modal-final-time">0s</strong></div>
        <div class="mstat"><span class="mstat-lbl">Mistakes</span><strong id="modal-final-mistakes">0</strong></div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-play-again" id="modal-btn-replay">Play Again</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { GridEngine, InputManager, safeStorage } from '../engine';
  import { adManager } from '../ads';

  const app = document.getElementById('game-app');
  if (app) {
    const slug = app.dataset.slug || 'game';
    const seconds = parseInt(app.dataset.seconds || '45', 10);
    const targetIds = JSON.parse(app.dataset.targets || '[]');

    const gridBoard = document.getElementById('grid-board') as HTMLElement;
    const metricTimer = document.getElementById('metric-timer') as HTMLElement;
    const metricRemaining = document.getElementById('metric-remaining') as HTMLElement;
    const metricScore = document.getElementById('metric-score') as HTMLElement;
    const metricAccuracy = document.getElementById('metric-accuracy') as HTMLElement;
    const metricPb = document.getElementById('metric-pb') as HTMLElement;

    const modal = document.getElementById('end-modal') as HTMLElement;
    const modalTitle = document.getElementById('modal-title') as HTMLElement;
    const modalSub = document.getElementById('modal-sub') as HTMLElement;
    const modalStars = document.getElementById('modal-stars') as HTMLElement;
    const modalFinalScore = document.getElementById('modal-final-score') as HTMLElement;
    const modalFinalAccuracy = document.getElementById('modal-final-accuracy') as HTMLElement;
    const modalFinalTime = document.getElementById('modal-final-time') as HTMLElement;
    const modalFinalMistakes = document.getElementById('modal-final-mistakes') as HTMLElement;

    const btnProjector = document.getElementById('btn-projector') as HTMLButtonElement;
    const btnSound = document.getElementById('btn-sound') as HTMLButtonElement;
    const btnShuffle = document.getElementById('btn-shuffle') as HTMLButtonElement;
    const btnReset = document.getElementById('btn-reset') as HTMLButtonElement;
    const modalBtnReplay = document.getElementById('modal-btn-replay') as HTMLButtonElement;
    const announcer = document.getElementById('game-announcer') as HTMLElement;
    let lastFocusedElement: HTMLElement | null = null;

    // Collect DOM tile items
    const tileButtons = Array.from(gridBoard.querySelectorAll<HTMLButtonElement>('.grid-tile'));
    const items = tileButtons.map((btn) => ({
      id: btn.getAttribute('data-tile-id') || '',
      value: btn.querySelector('.tile-val')?.textContent || '',
      display: btn.querySelector('.tile-val')?.textContent || ''
    }));

    // Update personal best display
    const updatePbDisplay = () => {
      const pb = safeStorage.getPersonalBest(slug);
      if (pb) {
        metricPb.textContent = `${pb.stars}★ (${pb.accuracy}%)`;
      } else {
        metricPb.textContent = '--';
      }
    };
    updatePbDisplay();

    // Sound preference: default OFF, read from localStorage in try/catch
    let soundOn = false;
    try {
      const savedSound = localStorage.getItem('gf_sound_enabled');
      if (savedSound !== null) {
        soundOn = savedSound === 'true';
      }
    } catch {}

    if (btnSound) {
      btnSound.setAttribute('aria-pressed', String(soundOn));
      const onIcon = btnSound.querySelector('.icon-sound-on') as HTMLElement;
      const offIcon = btnSound.querySelector('.icon-sound-off') as HTMLElement;
      if (onIcon && offIcon) {
        onIcon.style.display = soundOn ? 'inline' : 'none';
        offIcon.style.display = soundOn ? 'none' : 'inline';
      }
    }

    // Initialize Engine
    const engine = new GridEngine({
      slug,
      prompt: document.getElementById('game-prompt')?.textContent || '',
      seconds,
      items,
      targetIds,
      allowShuffle: true,
      soundEnabled: soundOn,
      onTick: (rem, stats) => {
        metricTimer.textContent = `${rem.toFixed(1)}s`;
        if (rem <= 5) {
          metricTimer.classList.add('urgent');
        } else {
          metricTimer.classList.remove('urgent');
        }
      },
      onTileUpdate: (tile) => {
        const btn = gridBoard.querySelector<HTMLButtonElement>(`button[data-tile-id="${tile.id}"]`);
        if (!btn) return;

        btn.classList.remove('is-correct', 'is-wrong', 'is-missed');
        if (tile.status === 'correct') {
          btn.classList.add('is-correct');
          btn.setAttribute('aria-pressed', 'true');
        } else if (tile.status === 'wrong') {
          btn.classList.add('is-wrong');
          if (announcer) {
            announcer.textContent = 'Incorrect tile selected. 2-second time penalty applied.';
          }
        } else if (tile.missed) {
          btn.classList.add('is-missed');
        }
      },
      onStateChange: (status, stats) => {
        metricRemaining.textContent = String(stats.remainingTargets);
        metricScore.textContent = String(stats.score);
        metricAccuracy.textContent = `${stats.accuracy}%`;

        if (status === 'idle') {
          modal.style.display = 'none';
          tileButtons.forEach((b) => {
            b.classList.remove('is-correct', 'is-wrong', 'is-missed');
            b.setAttribute('aria-pressed', 'false');
          });
        }
      },
      onGameEnd: (status, stats) => {
        lastFocusedElement = document.activeElement as HTMLElement | null;
        modal.style.display = 'flex';
        modalFinalScore.textContent = String(stats.score);
        modalFinalAccuracy.textContent = `${stats.accuracy}%`;
        modalFinalTime.textContent = `${stats.timeElapsed.toFixed(1)}s`;
        modalFinalMistakes.textContent = String(stats.mistakes);

        // Update stars visuals
        const starSpans = modalStars.querySelectorAll('.star-icon');
        starSpans.forEach((span, i) => {
          if (i < stats.stars) {
            span.classList.add('active');
          } else {
            span.classList.remove('active');
          }
        });

        if (status === 'completed') {
          modalTitle.textContent = 'Round Complete!';
          modalSub.textContent = stats.stars === 3 ? 'Flawless accuracy! 3 Stars earned.' : 'Great job! Targets found.';
          if (announcer) {
            announcer.textContent = `Round complete! ${stats.stars} stars earned. Score: ${stats.score}, Accuracy: ${stats.accuracy} percent.`;
          }
        } else {
          modalTitle.textContent = "Time's Up!";
          modalSub.textContent = 'Remaining targets are outlined in orange.';
          if (announcer) {
            announcer.textContent = `Time's up! Final score: ${stats.score}, Accuracy: ${stats.accuracy} percent.`;
          }
        }

        updatePbDisplay();

        // Move focus into modal
        setTimeout(() => {
          modalBtnReplay?.focus();
        }, 50);
      }
    });

    // Attach Input Manager
    const inputMgr = new InputManager(gridBoard, engine);

    // Button controls
    btnReset?.addEventListener('click', () => {
      engine.reset();
      adManager.handleRoundReset('ad-slot-game-bottom');
    });
    modalBtnReplay?.addEventListener('click', () => {
      modal.style.display = 'none';
      engine.reset();
      adManager.handleRoundReset('ad-slot-game-bottom');
      if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
        lastFocusedElement.focus();
      } else {
        btnReset?.focus();
      }
    });

    // Trap focus inside modal while active
    modal?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        modalBtnReplay?.focus();
      } else if (e.key === 'Escape') {
        modalBtnReplay?.click();
      }
    });

    btnProjector?.addEventListener('click', () => {
      const isBig = gridBoard.classList.toggle('projector-mode');
      btnProjector.setAttribute('aria-pressed', String(isBig));
    });

    btnShuffle?.addEventListener('click', () => {
      engine.shuffleTiles();
    });

    btnSound?.addEventListener('click', () => {
      soundOn = !soundOn;
      btnSound.setAttribute('aria-pressed', String(soundOn));
      engine.setSoundEnabled(soundOn);
      try {
        localStorage.setItem('gf_sound_enabled', String(soundOn));
      } catch {}
      const onIcon = btnSound.querySelector('.icon-sound-on') as HTMLElement;
      const offIcon = btnSound.querySelector('.icon-sound-off') as HTMLElement;
      if (onIcon && offIcon) {
        onIcon.style.display = soundOn ? 'inline' : 'none';
        offIcon.style.display = soundOn ? 'none' : 'inline';
      }
    });
  }
</script>

<style>
  .game-wrapper {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    user-select: none;
  }

  /* Header card: Prompt & Control Console */
  .game-header-card {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 20px;
    padding: 1.15rem 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.85rem;
    box-shadow: 0 6px 0 0 #0F172A;
  }
  .prompt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-caps);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #07006C;
    background: #E1E0FF;
    border: 1.5px solid #0F172A;
    padding: 0.2rem 0.7rem;
    border-radius: 9999px;
    margin-bottom: 0.35rem;
  }
  .prompt-title {
    font-family: var(--font-heading);
    font-size: 1.55rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .game-controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  /* Tactile 3D Action Buttons */
  .ctrl-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 12px;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: #0F172A;
    cursor: pointer;
    box-shadow: 0 4px 0 0 #0F172A;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s;
  }
  .ctrl-btn:hover {
    background: #F2F3FF;
    transform: translateY(-1px);
    box-shadow: 0 5px 0 0 #0F172A;
  }
  .ctrl-btn:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #0F172A;
  }
  
  /* High Energy Reset Button */
  .reset-btn {
    background: #FFDAD6;
    color: #93000A;
    box-shadow: 0 4px 0 0 #0F172A;
  }
  .reset-btn:hover {
    background: #BA1A1A;
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 5px 0 0 #0F172A;
  }
  .reset-btn:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #0F172A;
  }

  /* Telemetry Bar: Clean Tactile Pill Container */
  .telemetry-bar {
    background: #FFFFFF;
    color: #0F172A;
    border: 2px solid #0F172A;
    border-radius: 20px;
    padding: 0.65rem 0.85rem;
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
    box-shadow: 0 5px 0 0 #0F172A;
  }
  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.35rem 0.65rem;
    border-radius: 14px;
    min-width: 80px;
    border: 1.5px solid #0F172A;
  }
  .metric-label {
    font-family: var(--font-caps);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
  }
  .metric-val {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }
  
  /* Tactile Telemetry Color Badges */
  .timer-metric {
    background: #FFDF9F;
  }
  .timer-metric .metric-label {
    color: #6F5100;
  }
  .timer-metric .metric-val {
    color: #261A00;
  }
  .timer-metric .metric-val.urgent {
    color: #BA1A1A;
    animation: urgentPulse 0.4s infinite alternate ease-in-out;
  }
  @keyframes urgentPulse {
    from { transform: scale(1); }
    to { transform: scale(1.15); }
  }

  .targets-metric {
    background: #E1E0FF;
  }
  .targets-metric .metric-label {
    color: #07006C;
  }
  .targets-metric .metric-val {
    color: #2F2EBE;
  }

  .score-metric {
    background: #6BFF8F;
  }
  .score-metric .metric-label {
    color: #002109;
  }
  .score-metric .metric-val {
    color: #005321;
  }
  .score-metric .metric-val::before {
    content: '⭐ ';
    font-size: 0.95rem;
  }

  .accuracy-metric {
    background: #FFDAD6;
  }
  .accuracy-metric .metric-label {
    color: #93000A;
  }
  .accuracy-metric .metric-val {
    color: #BA1A1A;
  }

  .pb-metric {
    background: #DAE2FD;
  }
  .pb-metric .metric-label {
    color: #283044;
  }
  .pb-metric .metric-val {
    color: #131B2E;
  }

  /* 10x10 Grid: Tactile Neo-Brutalist Toybox Chassis */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 6px;
    background: #F2F3FF;
    border: 3px solid #0F172A;
    border-radius: 24px;
    padding: 12px;
    box-shadow: 0 8px 0 0 #0F172A;
    aspect-ratio: 1 / 1;
    touch-action: manipulation;
  }

  /* Projector Big Tile Mode */
  .grid-container.projector-mode {
    gap: 10px;
    padding: 16px;
  }
  .grid-container.projector-mode .grid-tile {
    font-size: 1.55rem;
    font-weight: 900;
  }

  /* 10x10 Number Tiles: 3D Physical Keycaps */
  .grid-tile {
    position: relative;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-bottom: 5px solid #C7C4D7;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    color: #0F172A;
    cursor: pointer;
    padding: 0;
    transition: transform 0.08s ease, border-bottom-width 0.08s ease, background-color 0.1s ease;
    outline: none;
    user-select: none;
    font-variant-numeric: tabular-nums;
  }
  .grid-tile:hover {
    background: #FAF8FF;
    transform: translateY(-2px);
    border-bottom-width: 6px;
  }
  .grid-tile:active {
    transform: translateY(3px);
    border-bottom-width: 2px !important;
  }
  .grid-tile:focus-visible {
    box-shadow: 0 0 0 3px #4648D4, 0 3px 0 0 #0F172A;
    z-index: 5;
  }

  /* Correct State: Sonic Lime Green Keycap */
  .grid-tile.is-correct {
    background: #22C55E !important;
    border-color: #0F172A !important;
    border-bottom: 5px solid #15803D !important;
    color: #FFFFFF !important;
    animation: popBounce 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  @keyframes popBounce {
    0% { transform: scale(0.85); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }
  .grid-tile .tile-icon {
    display: none;
    position: absolute;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.25));
  }
  .grid-tile.is-correct .icon-check {
    display: block;
    color: #FFFFFF;
  }
  .grid-tile.is-correct .tile-val {
    opacity: 0.15;
  }

  /* Wrong State: Coral Rose Keycap */
  .grid-tile.is-wrong {
    background: #F43F5E !important;
    border-color: #0F172A !important;
    border-bottom: 5px solid #BE123C !important;
    color: #FFFFFF !important;
    animation: tileShake 0.35s ease;
  }
  .grid-tile.is-wrong .icon-cross {
    display: block;
    color: #FFFFFF;
  }
  .grid-tile.is-wrong .tile-val {
    opacity: 0.15;
  }

  @keyframes tileShake {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-5px) rotate(-2deg); }
    40%, 80% { transform: translateX(5px) rotate(2deg); }
  }

  /* Missed State: Gold Outline */
  .grid-tile.is-missed {
    border: 2px dashed #795900 !important;
    border-bottom: 5px solid #795900 !important;
    background: #FFDF9F !important;
    color: #6F5100 !important;
  }

  /* Round End Victory Modal */
  .round-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(19, 27, 46, 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 24px;
    z-index: 30;
    padding: 1.25rem;
  }
  .round-modal-card {
    background: #FFFFFF;
    border: 3px solid #0F172A;
    border-radius: 26px;
    padding: 2.25rem 2rem;
    text-align: center;
    max-width: 380px;
    width: 100%;
    box-shadow: 0 8px 0 0 #0F172A;
