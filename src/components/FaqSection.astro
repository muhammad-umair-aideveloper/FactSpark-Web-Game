---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faq: FaqItem[];
}

const { faq } = Astro.props;
---

<section class="faq-section" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="faq-title">Frequently Asked Questions</h2>
  <div class="faq-list">
    {faq.map((item, index) => (
      <details class="faq-item" open={index === 0}>
        <summary class="faq-question">
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true">&#9662;</span>
        </summary>
        <div class="faq-answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-section {
    margin: 3rem 0;
  }
  .faq-title {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 1.5rem;
    letter-spacing: -0.015em;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .faq-item {
    background: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 0 #E2E8F0;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .faq-item:hover {
    border-color: #C7D2FE;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #C7D2FE;
  }
  .faq-item[open] {
    border-color: #818CF8;
    box-shadow: 0 6px 0 #818CF8;
  }
  .faq-question {
    padding: 1.15rem 1.4rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #0F172A;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #EEF2FF;
    color: #4F46E5;
    font-size: 0.85rem;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: #4F46E5;
    color: #FFFFFF;
  }
  .faq-answer {
    padding: 0 1.4rem 1.4rem;
    color: #475569;
    line-height: 1.65;
    font-size: 1rem;
    font-weight: 600;
  }
  .faq-answer p {
    margin: 0;
  }
</style>
