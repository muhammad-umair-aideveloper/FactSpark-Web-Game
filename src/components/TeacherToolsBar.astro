---
import { generateQrSvg } from '../teacher/qrGenerator';

interface Props {
  canonicalUrl: string;
  gameSlug: string;
  title: string;
}

const { canonicalUrl, gameSlug, title } = Astro.props;
const classroomShareUrl = `https://classroom.google.com/share?url=${encodeURIComponent(canonicalUrl)}`;
const qrSvg = generateQrSvg(canonicalUrl, 200);
const worksheetUrl = `/math/${gameSlug}/worksheet/`;
---

<div class="teacher-tools-bar">
  <div class="teacher-tools-label">
    <span class="teacher-icon" aria-hidden="true">&#127891;</span>
    <span class="teacher-text">Teacher Tools</span>
  </div>

  <div class="teacher-tools-actions">
    <!-- Google Classroom Share -->
    <a
      href={classroomShareUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="tool-btn classroom-btn"
      title="Share directly to Google Classroom"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      <span>Google Classroom</span>
    </a>

    <!-- Copy Direct Link -->
    <button type="button" class="tool-btn copy-btn" id="btn-copy-link" data-url={canonicalUrl}>
      <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <span class="copy-text">Copy Link</span>
    </button>

    <!-- QR Code Trigger -->
    <button type="button" class="tool-btn qr-btn" id="btn-open-qr">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      <span>QR Code</span>
    </button>

    <!-- Printable Worksheet -->
    <a href={worksheetUrl} class="tool-btn print-btn" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
      <span>Print Worksheet</span>
    </a>

    <!-- Fullscreen Mode -->
    <button type="button" class="tool-btn fullscreen-btn" id="btn-fullscreen">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
      <span>Fullscreen</span>
    </button>
  </div>

  <!-- QR Code Modal Dialog -->
  <dialog class="qr-modal-dialog" id="qr-dialog" aria-labelledby="qr-modal-title">
    <div class="qr-dialog-content">
      <h3 id="qr-modal-title" class="qr-title">Scan on Tablet or Phone</h3>
      <p class="qr-subtitle">{title}</p>
      <div class="qr-svg-holder" set:html={qrSvg} />
      <button type="button" class="qr-close-btn" id="btn-close-qr">Close</button>
    </div>
  </dialog>
</div>

<script>
  // Copy Link
  const copyBtn = document.getElementById('btn-copy-link');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const label = copyBtn.querySelector('.copy-text');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            label.textContent = original;
            copyBtn.classList.remove('copied');
          }, 2000);
        }
      } catch {
        // Fallback prompt if clipboard API is restricted
        window.prompt('Copy this game link for students:', url);
      }
    });
  }

  // QR Dialog
  const openQrBtn = document.getElementById('btn-open-qr');
  const qrDialog = document.getElementById('qr-dialog') as HTMLDialogElement | null;
  const closeQrBtn = document.getElementById('btn-close-qr');

  if (openQrBtn && qrDialog) {
    openQrBtn.addEventListener('click', () => {
      if (typeof qrDialog.showModal === 'function') {
        qrDialog.showModal();
      } else {
        qrDialog.setAttribute('open', 'true');
      }
    });
  }

  if (closeQrBtn && qrDialog) {
    closeQrBtn.addEventListener('click', () => {
      if (typeof qrDialog.close === 'function') {
        qrDialog.close();
      } else {
        qrDialog.removeAttribute('open');
      }
    });
  }

  // Fullscreen
  const fullscreenBtn = document.getElementById('btn-fullscreen');
  if (fullscreenBtn) {
    fullscreenBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    });
  }
</script>

<style>
  .teacher-tools-bar {
    background: #0F172A;
    border: 3px solid #312E81;
    border-bottom: 6px solid #1E1B4B;
    border-radius: 20px;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    gap: 0.85rem;
    box-shadow: 0 8px 0 #020617;
  }
  .teacher-tools-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: #818CF8;
    background: #1E1B4B;
    border: 1.5px solid #4338CA;
    border-bottom: 3px solid #312E81;
    padding: 0.35rem 0.85rem;
    border-radius: 10px;
    letter-spacing: 0.04em;
  }
  .teacher-tools-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  
  /* Tactile 3D Tool Buttons */
  .tool-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #1E1B4B;
    border: 1.5px solid #4338CA;
    border-bottom: 4px solid #312E81;
    border-radius: 12px;
    padding: 0.45rem 0.85rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    color: #E2E8F0;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    transition: transform 0.1s ease, border-bottom-width 0.1s ease, background 0.15s ease;
  }
  .tool-btn:hover {
    background: #2E2A72;
    border-color: #6366F1;
    border-bottom-color: #4338CA;
    color: #FFFFFF;
    transform: translateY(-2px);
  }
  .tool-btn:active {
    transform: translateY(2px);
    border-bottom-width: 2px;
  }

  .classroom-btn {
    background: #064E3B;
    border-color: #059669;
    border-bottom: 4px solid #047857;
    color: #A7F3D0;
  }
  .classroom-btn:hover {
    background: #047857;
    border-color: #10B981;
    border-bottom-color: #059669;
    color: #FFFFFF;
  }

  .copy-btn.copied {
    background: #064E3B;
    border-color: #10B981;
    border-bottom: 4px solid #047857;
    color: #A7F3D0;
  }

  .print-btn {
    background: #78350F;
    border-color: #D97706;
    border-bottom: 4px solid #B45309;
    color: #FDE68A;
  }
  .print-btn:hover {
    background: #92400E;
    border-color: #F59E0B;
    border-bottom-color: #B45309;
    color: #FFFFFF;
  }

  /* QR Modal Dialog */
  .qr-modal-dialog {
    border: none;
    border-radius: 24px;
    padding: 0;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    background: transparent;
  }
  .qr-modal-dialog::backdrop {
    background: rgba(11, 15, 25, 0.85);
    backdrop-filter: blur(8px);
  }
  .qr-dialog-content {
    background: #0F172A;
    padding: 2.25rem 2rem;
    border: 4px solid #4338CA;
    border-bottom: 8px solid #312E81;
    border-radius: 24px;
    text-align: center;
    max-width: 340px;
    box-shadow: 0 12px 0 #020617, 0 25px 40px rgba(0, 0, 0, 0.5);
  }
  .qr-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 0.35rem;
  }
  .qr-subtitle {
    font-size: 0.875rem;
    color: #94A3B8;
    margin: 0 0 1.25rem;
    font-weight: 600;
  }
  .qr-svg-holder {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: #FFFFFF;
    border: 3px dashed #6366F1;
    border-radius: 16px;
  }
  .qr-close-btn {
    background: #6366F1;
    border: none;
    border-bottom: 4px solid #4338CA;
    padding: 0.6rem 2.2rem;
    border-radius: 12px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
    transition: transform 0.1s ease, border-bottom-width 0.1s ease;
  }
  .qr-close-btn:hover {
    background: #4F46E5;
    transform: translateY(-2px);
  }
  .qr-close-btn:active {
    transform: translateY(2px);
    border-bottom-width: 2px;
  }
</style>
