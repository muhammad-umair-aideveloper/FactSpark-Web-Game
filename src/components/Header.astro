---
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-logo" aria-label="Grid Fluency Home">
      <span class="logo-icon-box" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7" rx="2" fill="currentColor"></rect>
          <rect x="14" y="3" width="7" height="7" rx="2"></rect>
          <rect x="14" y="14" width="7" height="7" rx="2" fill="currentColor"></rect>
          <rect x="3" y="14" width="7" height="7" rx="2"></rect>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-grid">Grid</span><span class="brand-fluency">Fluency</span>
      </span>
      <span class="brand-sparkle" aria-hidden="true">&#10024;</span>
    </a>

    <nav class="main-nav" aria-label="Main Navigation">
      <div class="nav-dropdown">
        <button class="nav-link dropdown-toggle" aria-haspopup="true">
          <span>Grades</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/math/grade-1/"><span>Grade 1</span> <span class="tag-badge">Gr 1</span></a>
          <a href="/math/grade-2/"><span>Grade 2</span> <span class="tag-badge">Gr 2</span></a>
          <a href="/math/grade-3/"><span>Grade 3</span> <span class="tag-badge">Gr 3</span></a>
          <a href="/math/grade-4/"><span>Grade 4</span> <span class="tag-badge">Gr 4</span></a>
          <a href="/math/grade-5/"><span>Grade 5</span> <span class="tag-badge">Gr 5</span></a>
          <a href="/math/grade-6/"><span>Grade 6</span> <span class="tag-badge">Gr 6</span></a>
        </div>
      </div>

      <div class="nav-dropdown">
        <button class="nav-link dropdown-toggle" aria-haspopup="true">
          <span>Topics</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/math/number-theory/">Number Theory</a>
          <a href="/math/operations/">Operations</a>
          <a href="/math/fractions/">Fractions</a>
          <a href="/math/place-value/">Place Value</a>
          <a href="/math/algebra-foundations/">Algebra Foundations</a>
        </div>
      </div>

      <a href="/playlist/" class="nav-link pill-nav">
        <span class="nav-icon" aria-hidden="true">&#127918;</span>
        <span>Class Playlists</span>
      </a>
      <a href="/pass/" class="pass-badge">
        <span class="pass-icon" aria-hidden="true">&#11088;</span>
        <span>Teacher Pass ($3.99)</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: rgba(11, 15, 25, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 3px solid #312E81;
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
  }
  .header-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  /* Brand Logo */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-heading);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .brand-logo:hover {
    transform: scale(1.04) rotate(-1deg);
  }
  .logo-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
    color: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 4px 0 #3730A3, 0 8px 12px rgba(79, 70, 229, 0.35);
  }
  .brand-text {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
  }
  .brand-grid {
    color: #F8FAFC;
    text-shadow: 0 0 10px rgba(248, 250, 252, 0.3);
  }
  .brand-fluency {
    color: #818CF8;
    background: linear-gradient(135deg, #818CF8 0%, #EC4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .brand-sparkle {
    font-size: 1rem;
    animation: pulseSparkle 2s infinite ease-in-out;
  }
  @keyframes pulseSparkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.8; }
    50% { transform: scale(1.25) rotate(15deg); opacity: 1; }
  }

  /* Navigation */
  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .nav-link {
    color: #F1F5F9;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    background: #1E1B4B;
    border: 2px solid #312E81;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    box-shadow: 0 4px 0 #0F172A;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease, background-color 0.15s, border-color 0.15s;
  }
  .nav-link:hover {
    color: #FFFFFF;
    background-color: #312E81;
    border-color: #6366F1;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #1E1B4B;
  }
  .nav-link:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #0F172A;
  }
  .chevron-icon {
    transition: transform 0.2s ease;
  }
  .nav-dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }

  /* Dropdown Menus */
  .nav-dropdown {
    position: relative;
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: #0F172A;
    min-width: 190px;
    border: 2px solid #312E81;
    border-radius: 18px;
    box-shadow: 0 14px 28px -6px rgba(0, 0, 0, 0.5), 0 5px 0 #020617;
    padding: 0.5rem;
    z-index: 60;
    animation: popMenu 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes popMenu {
    from { opacity: 0; transform: translateY(-6px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: block;
  }
  .dropdown-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    color: #E2E8F0;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 10px;
    transition: background-color 0.12s, color 0.12s, transform 0.12s;
  }
  .dropdown-menu a:hover {
    background-color: #1E1B4B;
    color: #38BDF8;
    transform: translateX(3px);
  }
  .tag-badge {
    font-size: 0.7rem;
    background: #312E81;
    color: #A78BFA;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  /* 3D Tactile Teacher Pass Badge */
  .pass-badge {
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    color: #FFFFFF;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-size: 0.925rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 4px 0 #B45309, 0 8px 14px rgba(245, 158, 11, 0.3);
    transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.12s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pass-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #B45309, 0 10px 18px rgba(245, 158, 11, 0.35);
  }
  .pass-badge:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #B45309;
  }
  .pass-icon {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .nav-dropdown { display: none; }
    .brand-sparkle { display: none; }
    .header-inner { padding: 0.6rem 1rem; }
    .pass-badge { font-size: 0.85rem; padding: 0.4rem 0.85rem; }
  }
</style>
