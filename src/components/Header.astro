---
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand-logo" aria-label="Fact Spark Home">
      <span class="logo-icon-box" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-title">Fact Spark</span>
        <span class="brand-sparkle" aria-hidden="true">⚡</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Main Navigation">
      <div class="nav-dropdown">
        <button class="nav-link dropdown-toggle" aria-haspopup="true">
          <span>Grades</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/math/grade-1/"><span>Grade 1</span> <span class="tag-badge badge-g1">Gr 1</span></a>
          <a href="/math/grade-2/"><span>Grade 2</span> <span class="tag-badge badge-g2">Gr 2</span></a>
          <a href="/math/grade-3/"><span>Grade 3</span> <span class="tag-badge badge-g3">Gr 3</span></a>
          <a href="/math/grade-4/"><span>Grade 4</span> <span class="tag-badge badge-g4">Gr 4</span></a>
          <a href="/math/grade-5/"><span>Grade 5</span> <span class="tag-badge badge-g5">Gr 5</span></a>
          <a href="/math/grade-6/"><span>Grade 6</span> <span class="tag-badge badge-g6">Gr 6</span></a>
        </div>
      </div>

      <div class="nav-dropdown">
        <button class="nav-link dropdown-toggle" aria-haspopup="true">
          <span>Topics</span>
          <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>
        <div class="dropdown-menu">
          <a href="/math/number-theory/">Number Theory</a>
          <a href="/math/operations/">Operations</a>
          <a href="/math/fractions/">Fractions</a>
          <a href="/math/place-value/">Place Value</a>
          <a href="/math/algebra-foundations/">Algebra Foundations</a>
        </div>
      </div>

      <a href="/playlist/" class="nav-link pill-nav">
        <span class="nav-icon" aria-hidden="true">📋</span>
        <span>Class Playlists</span>
      </a>

      <a href="/pass/" class="pass-badge">
        <span class="pass-icon" aria-hidden="true">🔑</span>
        <span>Teacher Pass ($3.99)</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 3px solid #0F172A;
    box-shadow: 0 4px 0 0 #C7C4D7;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  
  /* Brand Logo with Tactile Neo-Brutalism */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-family: var(--font-heading);
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .brand-logo:hover {
    transform: scale(1.03) rotate(-1deg);
  }
  .logo-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #4648D4;
    color: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 12px;
    box-shadow: 0 3px 0 0 #131B2E;
  }
  .brand-text {
    font-size: 1.45rem;
    font-weight: 900;
    letter-spacing: -0.025em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .brand-title {
    color: #0F172A;
  }
  .brand-sparkle {
    font-size: 1.25rem;
    animation: pulseSparkle 2.2s infinite ease-in-out;
  }
  @keyframes pulseSparkle {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.2) rotate(12deg); }
  }

  /* Navigation Links with Physical 3D Extrusion */
  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .nav-link {
    color: #0F172A;
    text-decoration: none;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 9999px;
    box-shadow: 0 3px 0 0 #0F172A;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1.05rem;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s;
  }
  .nav-link:hover {
    color: #4648D4;
    background-color: #F2F3FF;
    transform: translateY(-1px);
    box-shadow: 0 4px 0 0 #0F172A;
  }
  .nav-link:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 0 #0F172A;
  }
  .chevron-icon {
    transition: transform 0.2s ease;
  }
  .nav-dropdown:hover .chevron-icon {
    transform: rotate(180deg);
  }

  /* Tactile Dropdown Menus */
  .nav-dropdown {
    position: relative;
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    background: #FFFFFF;
    min-width: 210px;
    border: 2px solid #0F172A;
    border-radius: 18px;
    box-shadow: 0 6px 0 0 #0F172A;
    padding: 0.5rem;
    z-index: 60;
    animation: popMenu 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes popMenu {
    from { opacity: 0; transform: translateY(-6px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: block;
  }
  .dropdown-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    color: #131B2E;
    text-decoration: none;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    border-radius: 10px;
    transition: background-color 0.12s, color 0.12s, transform 0.08s;
  }
  .dropdown-menu a:hover {
    background-color: #EAEDFF;
    color: #4648D4;
    transform: translateX(3px);
  }

  /* Grade Station Badges */
  .tag-badge {
    font-size: 0.725rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-family: var(--font-caps);
    font-weight: 700;
    border: 1.5px solid #0F172A;
  }
  .badge-g1 { background: #0EA5E9; color: #FFFFFF; }
  .badge-g2 { background: #22C55E; color: #FFFFFF; }
  .badge-g3 { background: #F97316; color: #FFFFFF; }
  .badge-g4 { background: #A855F7; color: #FFFFFF; }
  .badge-g5 { background: #F43F5E; color: #FFFFFF; }
  .badge-g6 { background: #14B8A6; color: #FFFFFF; }

  /* 3D Tactile Teacher Pass Button */
  .pass-badge {
    background: #FFC329;
    color: #6F5100;
    border: 2px solid #0F172A;
    box-shadow: 0 4px 0 0 #795900;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-size: 0.925rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s;
  }
  .pass-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 0 0 #795900;
    background: #FFCD4D;
  }
  .pass-badge:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 0 #795900;
  }
  .pass-icon {
    font-size: 1rem;
  }

  @media (max-width: 768px) {
    .nav-dropdown { display: none; }
    .brand-sparkle { display: inline; }
    .header-inner { padding: 0.6rem 1rem; }
    .pass-badge { font-size: 0.825rem; padding: 0.4rem 0.85rem; }
  }
</style>
