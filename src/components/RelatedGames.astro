---
import { getGameBySlug } from '../contentLoader';

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

const relatedGames = relatedSlugs
  .map((slug) => getGameBySlug(slug))
  .filter((g): g is NonNullable<typeof g> => g !== undefined);
---

{relatedGames.length > 0 && (
  <section class="related-games-section" aria-labelledby="related-heading">
    <div class="section-title-box">
      <span class="rel-icon" aria-hidden="true">&#127918;</span>
      <h2 id="related-heading" class="section-title">More Speed Run Quests</h2>
    </div>
    <div class="games-grid">
      {relatedGames.map((game) => (
        <a href={`/math/${game.slug}/`} class="game-card">
          <div class="card-badge-row">
            <span class="card-badge">Grade {game.grade}</span>
            <span class="card-timer-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {game.game.seconds}s
            </span>
          </div>
          <h3 class="card-title">{game.seo.h1}</h3>
          <p class="card-prompt">{game.game.prompt}</p>
          <div class="card-footer">
            <span class="card-topic">{game.topic.replace('-', ' ')}</span>
            <span class="card-play-btn">
              <span>Play Quest</span>
              <span class="arrow-icon" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-games-section {
    margin: 3.5rem 0;
  }
  .section-title-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .rel-icon {
    font-size: 1.6rem;
    filter: drop-shadow(0 0 8px rgba(99, 102, 241, 0.6));
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  
  /* Collectible Arcade Cards */
  .game-card {
    position: relative;
    background: #0F172A;
    border: 2px solid #312E81;
    border-bottom: 6px solid #1E1B4B;
    border-radius: 20px;
    padding: 1.35rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    overflow: hidden;
  }
  .game-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg, #6366F1, #EC4899, #FACC15);
  }
  .game-card:hover {
    transform: translateY(-4px);
    border-color: #6366F1;
    border-bottom-color: #4338CA;
    box-shadow: 0 12px 24px rgba(99, 102, 241, 0.25);
  }
  .game-card:active {
    transform: translateY(2px);
    border-bottom-width: 3px;
  }

  .card-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    margin-top: 0.25rem;
  }
  .card-badge {
    background-color: #1E1B4B;
    color: #818CF8;
    border: 1.5px solid #4338CA;
    border-bottom: 3px solid #312E81;
    font-family: var(--font-heading);
    font-size: 0.775rem;
    font-weight: 800;
    padding: 0.2rem 0.65rem;
    border-radius: 10px;
    letter-spacing: 0.04em;
  }
  .card-timer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: #451A03;
    color: #FDBA74;
    border: 1.5px solid #C2410C;
    border-bottom: 3px solid #9A3412;
    border-radius: 10px;
    padding: 0.2rem 0.6rem;
    font-size: 0.775rem;
    font-family: var(--font-heading);
    font-weight: 800;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }
  .card-prompt {
    font-size: 0.875rem;
    color: #94A3B8;
    margin: 0 0 1rem;
    flex-grow: 1;
    line-height: 1.5;
    font-weight: 600;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.825rem;
    border-top: 2px dashed #1E293B;
    padding-top: 0.75rem;
  }
  .card-topic {
    text-transform: capitalize;
    color: #CBD5E1;
    font-weight: 700;
  }
  .card-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #6366F1;
    border-bottom: 4px solid #4338CA;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.775rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.8rem;
    border-radius: 12px;
    transition: transform 0.1s ease, border-bottom-width 0.1s ease;
  }
  .arrow-icon {
    transition: transform 0.2s ease;
  }
  .game-card:hover .arrow-icon {
    transform: translateX(3px);
  }
</style>
