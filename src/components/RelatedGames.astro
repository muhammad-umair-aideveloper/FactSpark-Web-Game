---
import { getGameBySlug } from '../contentLoader';

interface Props {
  relatedSlugs: string[];
}

const { relatedSlugs } = Astro.props;

const relatedGames = relatedSlugs
  .map((slug) => getGameBySlug(slug))
  .filter((g): g is NonNullable<typeof g> => g !== undefined);
---

{relatedGames.length > 0 && (
  <section class="related-games-section" aria-labelledby="related-heading">
    <div class="section-title-box">
      <span class="rel-icon" aria-hidden="true">&#127918;</span>
      <h2 id="related-heading" class="section-title">More Speed Run Quests</h2>
    </div>
    <div class="games-grid">
      {relatedGames.map((game) => (
        <a href={`/math/${game.slug}/`} class="game-card">
          <div class="card-badge-row">
            <span class="card-badge">Grade {game.grade}</span>
            <span class="card-timer-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {game.game.seconds}s
            </span>
          </div>
          <h3 class="card-title">{game.seo.h1}</h3>
          <p class="card-prompt">{game.game.prompt}</p>
          <div class="card-footer">
            <span class="card-topic">{game.topic.replace('-', ' ')}</span>
            <span class="card-play-btn">
              <span>Play Quest</span>
              <span class="arrow-icon" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-games-section {
    margin: 3.5rem 0;
  }
  .section-title-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .rel-icon {
    font-size: 1.6rem;
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  
  /* Tactile Neo-Brutalist Game Cards */
  .game-card {
    position: relative;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 20px;
    box-shadow: 0 6px 0 0 #0F172A;
    padding: 1.35rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    overflow: hidden;
  }
  .game-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: #4648D4;
    border-bottom: 2px solid #0F172A;
  }
  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 0 0 #0F172A;
  }
  .game-card:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 0 #0F172A;
  }

  .card-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    margin-top: 0.25rem;
  }
  .card-badge {
    background-color: #E1E0FF;
    color: #07006C;
    border: 1.5px solid #0F172A;
    font-family: var(--font-caps);
    font-size: 0.775rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 10px;
    letter-spacing: 0.04em;
  }
  .card-timer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    background: #FFDF9F;
    color: #6F5100;
    border: 1.5px solid #0F172A;
    border-radius: 10px;
    padding: 0.2rem 0.6rem;
    font-size: 0.775rem;
    font-family: var(--font-caps);
    font-weight: 700;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 0.45rem;
    line-height: 1.35;
  }
  .card-prompt {
    font-size: 0.875rem;
    color: #464554;
    margin: 0 0 1rem;
    flex-grow: 1;
    line-height: 1.5;
    font-weight: 500;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.825rem;
    border-top: 2px dashed #C7C4D7;
    padding-top: 0.75rem;
  }
  .card-topic {
    text-transform: capitalize;
    color: #464554;
    font-weight: 700;
    font-family: var(--font-caps);
  }
  .card-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #22C55E;
    border: 2px solid #0F172A;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 0.775rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.8rem;
    border-radius: 12px;
    box-shadow: 0 3px 0 0 #15803D;
    transition: transform 0.08s ease, background-color 0.1s;
  }
  .card-play-btn:hover {
    background: #16A34A;
  }
  .arrow-icon {
    transition: transform 0.2s ease;
  }
  .game-card:hover .arrow-icon {
    transform: translateX(3px);
  }
</style>
