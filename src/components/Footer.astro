<style>
  .site-footer {
    background-color: #0f172a;
    color: #94a3b8;
    padding: 3rem 1rem 1.5rem;
    margin-top: 4rem;
    border-top: 1px solid #1e293b;
    font-size: 0.875rem;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .brand-col .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #f8fafc;
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .footer-brand strong {
    color: #818cf8;
  }
  .brand-desc {
    line-height: 1.5;
    margin-bottom: 1rem;
    max-width: 320px;
  }
  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .col-title {
    color: #f1f5f9;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .col-links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s;
  }
  .col-links a:hover {
    color: #818cf8;
  }
  .footer-bottom {
    border-top: 1px solid #1e293b;
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.775rem;
    color: #64748b;
  }
  @media (max-width: 768px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
