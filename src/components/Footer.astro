<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-columns">
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Grid<strong>Fluency</strong></span>
        </div>
        <p class="brand-desc">
          Fast-paced, data-driven 10x10 math fluency games optimized for classroom Chromebooks. Built for speed, accessibility, and zero-distraction student learning.
        </p>
        <div class="compliance-badge">
          <span class="shield-icon" aria-hidden="true">&#128737;</span>
          <span>We don't collect personal information from students.</span>
        </div>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Grade Levels</h3>
        <ul class="col-links">
          <li><a href="/math/grade-1/">Grade 1 Fluency</a></li>
          <li><a href="/math/grade-2/">Grade 2 Fluency</a></li>
          <li><a href="/math/grade-3/">Grade 3 Fluency</a></li>
          <li><a href="/math/grade-4/">Grade 4 Fluency</a></li>
          <li><a href="/math/grade-5/">Grade 5 Fluency</a></li>
          <li><a href="/math/grade-6/">Grade 6 Fluency</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Math Domains</h3>
        <ul class="col-links">
          <li><a href="/math/number-theory/">Number Theory</a></li>
          <li><a href="/math/operations/">Operations & Tables</a></li>
          <li><a href="/math/fractions/">Fraction Equivalence</a></li>
          <li><a href="/math/place-value/">Place Value & Range</a></li>
          <li><a href="/math/algebra-foundations/">Algebra Foundations</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Classroom Tools</h3>
        <ul class="col-links">
          <li><a href="/playlist/">Class Playlist Builder</a></li>
          <li><a href="/pass/">Teacher / Parent Pass</a></li>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/sitemap.xml">XML Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Grid Fluency. All rights reserved. Common Core State Standards &copy; Copyright 2010. National Governors Association Center for Best Practices and Council of Chief State School Officers.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #0F172A;
    color: #94A3B8;
    padding: 3.5rem 1.25rem 2rem;
    margin-top: 5rem;
    border-top: 3px solid #1E293B;
    font-size: 0.9rem;
    position: relative;
    z-index: 10;
  }
  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .brand-col .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: #F8FAFC;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.85rem;
  }
  .footer-brand svg {
    color: #6366F1;
  }
  .footer-brand strong {
    color: #818CF8;
  }
  .brand-desc {
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 340px;
    color: #94A3B8;
    font-weight: 600;
  }
  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1.5px solid #334155;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-heading);
  }
  .col-title {
    font-family: var(--font-heading);
    color: #F1F5F9;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1.15rem;
    letter-spacing: -0.01em;
  }
  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .col-links a {
    color: #94A3B8;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s, transform 0.15s;
    display: inline-block;
  }
  .col-links a:hover {
    color: #A5B4FC;
    transform: translateX(4px);
  }
  .footer-bottom {
    border-top: 1px solid #1E293B;
    padding-top: 1.75rem;
    text-align: center;
    font-size: 0.8rem;
    color: #64748B;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
