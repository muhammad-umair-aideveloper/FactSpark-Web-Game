<style>
  .site-footer {
    background-color: var(--surface-low, #F2F3FF);
    color: var(--ink-muted, #464554);
    padding: 3.5rem 1.5rem 2rem;
    margin-top: 5rem;
    border-top: 3px solid #0F172A;
    box-shadow: 0 -4px 0 0 #C7C4D7;
    font-size: 0.9rem;
    position: relative;
    z-index: 10;
  }
  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: 2fr 1.1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }
  .brand-col .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0F172A;
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 900;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }
  .brand-bolt {
    font-size: 1.5rem;
  }
  .brand-desc {
    line-height: 1.6;
    margin-bottom: 1.25rem;
    max-width: 380px;
    color: #464554;
    font-weight: 500;
  }
  .compliance-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #FFFFFF;
    color: #006B2D;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.775rem;
    font-weight: 700;
    font-family: var(--font-caps);
  }
  .col-title {
    font-family: var(--font-heading);
    color: #0F172A;
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 1.15rem;
    letter-spacing: -0.015em;
  }
  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .col-links a {
    color: #464554;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.12s, transform 0.08s;
    display: inline-block;
  }
  .col-links a:hover {
    color: #4648D4;
    transform: translateX(4px);
  }
  .footer-bottom {
    border-top: 2px dashed #C7C4D7;
    padding-top: 1.75rem;
    text-align: center;
    font-size: 0.8rem;
    color: #464554;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .footer-columns {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
