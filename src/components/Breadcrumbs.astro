---
interface Crumb {
  name: string;
  url: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="breadcrumbs-container">
  <ol class="breadcrumbs-list">
    {crumbs.map((crumb, idx) => {
      const isLast = idx === crumbs.length - 1;
      return (
        <li class="breadcrumb-item">
          {isLast ? (
            <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
          ) : (
            <>
              <a href={crumb.url} class="breadcrumb-link">{crumb.name}</a>
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs-container {
    padding: 0.25rem 0;
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
  }
  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.45rem;
  }
  .breadcrumb-item {
    display: flex;
    align-items: center;
    color: #464554;
  }
  .breadcrumb-link {
    color: #4648D4;
    text-decoration: none;
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 0.8rem;
    background: #FFFFFF;
    border: 1.5px solid #0F172A;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    box-shadow: 0 2px 0 0 #0F172A;
    transition: transform 0.08s, box-shadow 0.08s, color 0.1s;
    letter-spacing: 0.03em;
  }
  .breadcrumb-link:hover {
    color: #2F2EBE;
    background: #F2F3FF;
    transform: translateY(-1px);
    box-shadow: 0 3px 0 0 #0F172A;
  }
  .breadcrumb-separator {
    margin-left: 0.45rem;
    color: #0F172A;
    font-weight: 800;
  }
  .breadcrumb-current {
    color: #07006C;
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 0.8rem;
    background: #E1E0FF;
    border: 1.5px solid #0F172A;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    letter-spacing: 0.03em;
  }
</style>
