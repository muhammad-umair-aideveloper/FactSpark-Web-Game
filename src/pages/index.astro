---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGames, getAllGrades, getAllTopics } from '../contentLoader';

const allGames = getAllGames();
const grades = getAllGrades();
const topics = getAllTopics();

const canonicalUrl = 'https://gridfluency.com/';
const title = 'Fact Spark ⚡ - Fast 10x10 Math Facts & Number Sense Speed Games';
const metaDescription = 'Play 40+ fast-paced 10x10 math fluency games on classroom Chromebooks. Master primes, factors, multiples, and fractions with zero setup.';
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Section: Tactile Arcade Launchpad -->
  <section class="hero-section">
    <!-- Floating Reward Badges -->
    <div class="floating-chips-row" aria-label="Game features">
      <span class="hero-chip streak-chip">🔥 60s Streak</span>
      <span class="hero-chip speed-chip">⚡ Fast Play</span>
      <span class="hero-chip lag-chip">🏆 Zero Lag</span>
      <span class="hero-chip free-chip">🎮 100% Free</span>
    </div>

    <div class="hero-top-badge">
      <span class="badge-icon" aria-hidden="true">&#128640;</span>
      <span>Built for School Chromebooks &bull; We don't collect personal information from students &bull; No Passwords</span>
    </div>

    <div class="hero-content-wrap">
      <h1 class="hero-headline">
        Master Math Facts in <span class="highlight-badge">60-Second</span> Grid Speed Runs
      </h1>
      
      <p class="hero-subhead">
        The ultimate arcade math battleground for elementary &amp; middle schoolers! 
        Tap primes, factor bursts, multi-combos, and fraction matches on the fast-paced 10&times;10 grid with instant audio-visual rewards.
      </p>

      <!-- Mascot & Launchpad Action Area -->
      <div class="mascot-launchpad">
        <div class="mascot-container" aria-hidden="true">
          <div class="mascot-bubble">Ready, Set, Solve! ⚡</div>
          <div class="mascot-avatar">
            <svg width="72" height="72" viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="36" fill="#6063EE" stroke="#0F172A" stroke-width="4"/>
              <circle cx="28" cy="34" r="6" fill="#FFFFFF"/>
              <circle cx="29.5" cy="34" r="3" fill="#0F172A"/>
              <circle cx="52" cy="34" r="6" fill="#FFFFFF"/>
              <circle cx="50.5" cy="34" r="3" fill="#0F172A"/>
              <path d="M30 48 Q40 58 50 48" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" fill="none"/>
              <circle cx="20" cy="42" r="4" fill="#F43F5E" opacity="0.5"/>
              <circle cx="60" cy="42" r="4" fill="#F43F5E" opacity="0.5"/>
              <polygon points="40,6 45,18 35,18" fill="#FFC329" stroke="#0F172A" stroke-width="1.5"/>
              <circle cx="40" cy="6" r="3" fill="#FFDF9F"/>
            </svg>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/math/prime-numbers-to-100-game/" class="cta-primary btn-3d">
            <span class="play-icon" aria-hidden="true">&#9658;</span>
            <span>PRESS TO PLAY NOW 🚀</span>
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/playlist/" class="cta-secondary btn-3d">
            <span class="btn-icon" aria-hidden="true">📋</span>
            <span>Create Class Playlist</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter by Grade Level: Tactile Grade Stations -->
  <section class="grades-strip" aria-labelledby="grades-strip-title">
    <div class="section-title-wrap">
      <span class="section-icon" aria-hidden="true">🏫</span>
      <h2 id="grades-strip-title" class="strip-label">Curriculum Grade Stations</h2>
    </div>
    <div class="grades-pills">
      {grades.map((grade) => (
        <a href={`/math/grade-${grade}/`} class={`grade-card grade-color-${grade}`}>
          <div class="grade-badge-circle">Gr {grade}</div>
          <div class="grade-info">
            <strong class="grade-name">Grade {grade}</strong>
            <span class="grade-count">{allGames.filter((g) => g.grade === grade).length} Speed Challenges</span>
          </div>
          <span class="grade-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Filter by Math Topic: Playful Neo-Brutalist Pills -->
  <section class="topics-strip" aria-labelledby="topics-strip-title">
    <div class="section-title-wrap">
      <span class="section-icon" aria-hidden="true">🎯</span>
      <h2 id="topics-strip-title" class="strip-label">Explore Math Worlds</h2>
    </div>
    <div class="topics-pills">
      {topics.map((topic) => (
        <a href={`/math/${topic}/`} class="topic-pill">
          <span class="topic-dot" aria-hidden="true">&#9670;</span>
          <span class="topic-name">{topic.replace('-', ' ')}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- All 40 Games Directory: Arcade Quest Grid -->
  <section class="games-directory" aria-labelledby="directory-title">
    <div class="directory-header">
      <div class="directory-title-box">
        <span class="badge-burst" aria-hidden="true">🔥</span>
        <div>
          <h2 id="directory-title" class="section-title">All Math Speed Challenges</h2>
          <p class="section-subtitle">Jump into any 10&times;10 grid challenge below!</p>
        </div>
      </div>
      <span class="count-badge">
        <span class="badge-sparkle" aria-hidden="true">⚡</span>
        {allGames.length} Challenges Ready
      </span>
    </div>

    <div class="games-grid">
      {allGames.map((game, idx) => (
        <a href={`/math/${game.slug}/`} class={`game-card card-variant-${idx % 4}`}>
          <div class="card-meta">
            <span class="card-grade">Grade {game.grade}</span>
            <span class="card-timer">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {game.game.seconds}s
            </span>
          </div>

          <h3 class="card-title">{game.seo.h1}</h3>
          <p class="card-prompt">{game.game.prompt}</p>

          <div class="card-footer">
            <span class="card-topic">{game.topic.replace('-', ' ')}</span>
            <span class="play-pill">
              <span>Play</span>
              <span class="play-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Teacher Features Banner: Game Master Deck -->
  <section class="teacher-banner">
    <div class="teacher-banner-deco" aria-hidden="true">👑</div>
    <div class="teacher-banner-content">
      <span class="teacher-tag">Teacher &amp; Educator Command Deck</span>
      <h2>Classroom-Ready Tools with Zero Setup</h2>
      <p>
        Zero accounts to create, no lost passwords, and 100% free student access. Instantly beam challenges to Google Classroom, encode multi-game playlist circuits directly in the URL, or print 10&times;10 worksheets with teacher keys.
      </p>
      <div class="teacher-badges">
        <span class="t-badge">&#10003; 1-Click Google Classroom</span>
        <span class="t-badge">&#10003; State-in-URL Playlists</span>
        <span class="t-badge">&#10003; Instant Printable Worksheets</span>
        <span class="t-badge">&#10003; Fullscreen Projector Mode</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    text-align: center;
    padding: 2.5rem 1rem 3rem;
    max-width: 960px;
    margin: 0 auto;
    position: relative;
  }
  
  /* Floating Reward Badges */
  .floating-chips-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .hero-chip {
    font-family: var(--font-caps);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    background: #FFFFFF;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    animation: floatChip 4s ease-in-out infinite;
    user-select: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .streak-chip { color: #C2410C; background: #FFDF9F; animation-delay: 0s; }
  .speed-chip { color: #07006C; background: #E1E0FF; animation-delay: 0.8s; }
  .lag-chip { color: #005321; background: #6BFF8F; animation-delay: 1.6s; }
  .free-chip { color: #93000A; background: #FFDAD6; animation-delay: 2.4s; }

  @keyframes floatChip {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #E1E0FF;
    color: #07006C;
    border: 2px solid #0F172A;
    font-family: var(--font-caps);
    font-size: 0.825rem;
    font-weight: 700;
    padding: 0.4rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    box-shadow: 0 3px 0 0 #0F172A;
  }
  .badge-icon {
    font-size: 1rem;
  }

  .hero-headline {
    font-size: 3.25rem;
    font-weight: 900;
    line-height: 1.15;
    color: #0F172A;
    margin: 0 0 1.25rem;
    letter-spacing: -0.03em;
  }
  
  /* Tactile Highlight Pill for 60-Second */
  .highlight-badge {
    position: relative;
    display: inline-block;
    background: #FFC329;
    color: #6F5100;
    border-radius: 14px;
    padding: 2px 16px;
    border: 2px solid #0F172A;
    box-shadow: 0 4px 0 0 #795900;
    transform: rotate(-1.5deg);
    margin: 0 0.25rem;
    font-weight: 900;
  }

  .hero-subhead {
    font-size: 1.2rem;
    color: #464554;
    line-height: 1.65;
    margin: 0 auto 2.25rem;
    max-width: 760px;
    font-weight: 500;
  }

  /* Mascot & Launchpad Area */
  .mascot-launchpad {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .mascot-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .mascot-avatar {
    animation: mascotBounce 3s ease-in-out infinite;
    filter: drop-shadow(0 6px 12px rgba(70, 72, 212, 0.25));
  }
  @keyframes mascotBounce {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(2deg); }
  }
  .mascot-bubble {
    background: #FFFFFF;
    color: #0F172A;
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.95rem;
    border-radius: 14px;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    margin-bottom: -6px;
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    width: 100%;
  }
  
  /* 3D Tactile CTA Buttons */
  .cta-primary {
    background: #6063EE;
    color: #FFFFFF;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    padding: 1.1rem 2.2rem;
    border: 2px solid #0F172A;
    border-radius: 16px;
    box-shadow: 0 6px 0 0 #2F2EBE;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s ease;
  }
  .cta-primary:hover {
    background: #7375FF;
    transform: translateY(-2px);
    box-shadow: 0 8px 0 0 #2F2EBE;
  }
  .cta-primary:active {
    transform: translateY(4px);
    box-shadow: 0 2px 0 0 #2F2EBE;
  }
  .play-icon {
    font-size: 0.95rem;
    color: #FFFFFF;
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-secondary {
    background: #FFFFFF;
    color: #0F172A;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 1.1rem 1.9rem;
    border: 2px solid #0F172A;
    border-radius: 16px;
    box-shadow: 0 5px 0 0 #0F172A;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s;
  }
  .cta-secondary:hover {
    background: #F2F3FF;
    transform: translateY(-2px);
    box-shadow: 0 7px 0 0 #0F172A;
  }
  .cta-secondary:active {
    transform: translateY(4px);
    box-shadow: 0 1px 0 0 #0F172A;
  }

  /* Section Titles */
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .section-icon {
    font-size: 1.35rem;
  }
  .strip-label {
    font-size: 1.4rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Grades Strip: Tactile Station Cards */
  .grades-strip {
    margin: 3rem 0;
  }
  .grades-pills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(185px, 1fr));
    gap: 1rem;
  }
  .grade-card {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 18px;
    box-shadow: 0 5px 0 0 #0F172A;
    padding: 1rem 1.15rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.12s ease;
  }
  .grade-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 0 0 #0F172A;
  }
  .grade-card:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 0 #0F172A;
  }
  .grade-badge-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    font-family: var(--font-caps);
    font-weight: 700;
    font-size: 0.95rem;
    color: #FFFFFF;
    flex-shrink: 0;
    border: 2px solid #0F172A;
  }
  /* Grade World Palette (DESIGN.md) */
  .grade-color-1 .grade-badge-circle { background: #0EA5E9; box-shadow: 0 3px 0 0 #0284C7; }
  .grade-color-2 .grade-badge-circle { background: #22C55E; box-shadow: 0 3px 0 0 #15803D; }
  .grade-color-3 .grade-badge-circle { background: #F97316; box-shadow: 0 3px 0 0 #C2410C; }
  .grade-color-4 .grade-badge-circle { background: #A855F7; box-shadow: 0 3px 0 0 #7E22CE; }
  .grade-color-5 .grade-badge-circle { background: #F43F5E; box-shadow: 0 3px 0 0 #BE123C; }
  .grade-color-6 .grade-badge-circle { background: #14B8A6; box-shadow: 0 3px 0 0 #0F766E; }
  
  .grade-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .grade-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: #0F172A;
  }
  .grade-count {
    font-family: var(--font-caps);
    font-size: 0.75rem;
    color: #464554;
    font-weight: 700;
  }
  .grade-arrow {
    color: #0F172A;
    font-weight: 800;
    transition: transform 0.15s ease;
  }
  .grade-card:hover .grade-arrow {
    transform: translateX(4px);
  }

  /* Topics Strip */
  .topics-strip {
    margin: 3rem 0;
  }
  .topics-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .topic-pill {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    color: #0F172A;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: capitalize;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.08s ease, box-shadow 0.08s ease, background-color 0.1s ease;
  }
  .topic-dot {
    font-size: 0.65rem;
    color: #4648D4;
  }
  .topic-pill:hover {
    background: #EAEDFF;
    color: #4648D4;
    transform: translateY(-2px);
    box-shadow: 0 5px 0 0 #0F172A;
  }
  .topic-pill:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 0 #0F172A;
  }

  /* Games Directory & Cards */
  .games-directory {
    margin: 4.5rem 0;
  }
  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .directory-title-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .badge-burst {
    font-size: 1.75rem;
  }
  .section-title {
    font-size: 2.1rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .section-subtitle {
    margin: 0.2rem 0 0;
    color: #464554;
    font-weight: 500;
    font-size: 1rem;
  }
  .count-badge {
    background: #FFFFFF;
    color: #07006C;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    font-family: var(--font-caps);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .badge-sparkle {
    color: #FFC329;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  /* Tactile Arcade Game Selection Cards */
  .game-card {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 20px;
    box-shadow: 0 6px 0 0 #0F172A;
    padding: 1.4rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    overflow: hidden;
  }
  .game-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 7px;
    background: #4648D4;
    border-bottom: 2px solid #0F172A;
  }
  .card-variant-0::before { background: #0EA5E9; }
  .card-variant-1::before { background: #22C55E; }
  .card-variant-2::before { background: #FFC329; }
  .card-variant-3::before { background: #F43F5E; }

  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 0 0 #0F172A;
  }
  .game-card:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 0 #0F172A;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    padding-top: 0.25rem;
  }
  .card-grade {
    background: #E1E0FF;
    color: #07006C;
    border: 1.5px solid #0F172A;
    font-family: var(--font-caps);
    font-size: 0.775rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
  }
  .card-timer {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFDF9F;
    color: #6F5100;
    border: 1.5px solid #0F172A;
    border-radius: 9999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.775rem;
    font-family: var(--font-caps);
    font-weight: 700;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #0F172A;
    margin: 0 0 0.45rem;
    line-height: 1.3;
  }
  .card-prompt {
    font-size: 0.95rem;
    color: #464554;
    line-height: 1.5;
    margin: 0 0 1.25rem;
    flex-grow: 1;
    font-weight: 500;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    border-top: 2px dashed #C7C4D7;
    padding-top: 0.85rem;
  }
  .card-topic {
    text-transform: capitalize;
    color: #464554;
    font-weight: 700;
    font-size: 0.825rem;
    font-family: var(--font-caps);
  }
  
  /* Duolingo / Sonic Lime Green 3D Button */
  .play-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #22C55E;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.825rem;
    padding: 0.4rem 1rem;
    border: 2px solid #0F172A;
    border-radius: 12px;
    box-shadow: 0 3px 0 0 #15803D;
    transition: transform 0.08s ease, background-color 0.1s ease;
  }
  .game-card:hover .play-pill {
    background: #16A34A;
    transform: scale(1.04);
  }
  .play-arrow {
    transition: transform 0.2s ease;
  }
  .game-card:hover .play-arrow {
    transform: translateX(4px);
  }

  /* Teacher Banner */
  .teacher-banner {
    position: relative;
    background: linear-gradient(135deg, #4648D4 0%, #2F2EBE 100%);
    color: #FFFFFF;
    border-radius: 24px;
    padding: 3rem 2.5rem;
    margin: 5rem 0 2rem;
    border: 3px solid #0F172A;
    box-shadow: 0 8px 0 0 #0F172A;
    overflow: hidden;
  }
  .teacher-banner-deco {
    position: absolute;
    right: 2rem;
    bottom: -1rem;
    font-size: 9rem;
