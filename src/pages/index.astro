---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllGames, getAllGrades, getAllTopics } from '../contentLoader';

const allGames = getAllGames();
const grades = getAllGrades();
const topics = getAllTopics();

const canonicalUrl = 'https://gridfluency.com/';
const title = 'Grid Fluency - Fast 10x10 Math Facts & Number Sense Speed Games';
const metaDescription = 'Play 40+ fast-paced 10x10 math fluency games on classroom Chromebooks. Master primes, factors, multiples, and fractions with zero setup.';
---

<BaseLayout
  title={title}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <!-- Hero Section: Arcade Launchpad -->
  <section class="hero-section">
    <!-- Floating Reward Badges -->
    <div class="floating-chips-row" aria-label="Game features">
      <span class="hero-chip streak-chip">🔥 60s Streak</span>
      <span class="hero-chip speed-chip">⚡ Fast Play</span>
      <span class="hero-chip lag-chip">🏆 Zero Lag</span>
      <span class="hero-chip free-chip">🎮 100% Free</span>
    </div>

    <div class="hero-top-badge">
      <span class="badge-icon" aria-hidden="true">&#128640;</span>
      <span>Built for School Chromebooks &bull; COPPA Compliant &bull; No Passwords</span>
    </div>

    <div class="hero-content-wrap">
      <h1 class="hero-headline">
        Master Math Facts in <span class="highlight-badge"><span class="neon-glow" aria-hidden="true"></span>60-Second</span> Grid Speed Runs
      </h1>
      
      <p class="hero-subhead">
        The ultimate arcade math battleground for elementary &amp; middle schoolers! 
        Tap primes, factor bursts, multi-combos, and fraction matches on the fast-paced 10&times;10 grid with instant audio-visual rewards.
      </p>

      <!-- Mascot & Launchpad Action Area -->
      <div class="mascot-launchpad">
        <div class="mascot-container" aria-hidden="true">
          <div class="mascot-bubble">Ready, Set, Solve! ⚡</div>
          <div class="mascot-avatar">
            <svg width="72" height="72" viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="36" fill="#6366F1" stroke="#4F46E5" stroke-width="4"/>
              <circle cx="28" cy="34" r="6" fill="#FFFFFF"/>
              <circle cx="29.5" cy="34" r="3" fill="#0F172A"/>
              <circle cx="52" cy="34" r="6" fill="#FFFFFF"/>
              <circle cx="50.5" cy="34" r="3" fill="#0F172A"/>
              <path d="M30 48 Q40 58 50 48" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" fill="none"/>
              <circle cx="20" cy="42" r="4" fill="#F472B6" opacity="0.6"/>
              <circle cx="60" cy="42" r="4" fill="#F472B6" opacity="0.6"/>
              <polygon points="40,6 45,18 35,18" fill="#F59E0B"/>
              <circle cx="40" cy="6" r="3" fill="#FDE68A"/>
            </svg>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/math/prime-numbers-to-100-game/" class="cta-primary btn-3d">
            <span class="play-icon" aria-hidden="true">&#9658;</span>
            <span>PRESS TO PLAY NOW</span>
            <span class="cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a href="/playlist/" class="cta-secondary btn-3d">
            <span class="btn-icon" aria-hidden="true">&#127918;</span>
            <span>Create Class Playlist</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter by Grade Level: Tactile Grade Stations -->
  <section class="grades-strip" aria-labelledby="grades-strip-title">
    <div class="section-title-wrap">
      <span class="section-icon" aria-hidden="true">&#127891;</span>
      <h2 id="grades-strip-title" class="strip-label">Choose Your Grade Station</h2>
    </div>
    <div class="grades-pills">
      {grades.map((grade) => (
        <a href={`/math/grade-${grade}/`} class={`grade-card grade-color-${grade}`}>
          <div class="grade-badge-circle">Gr {grade}</div>
          <div class="grade-info">
            <strong class="grade-name">Grade {grade}</strong>
            <span class="grade-count">{allGames.filter((g) => g.grade === grade).length} Speed Challenges</span>
          </div>
          <span class="grade-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Filter by Math Topic: Playful Neo-Pop Pills -->
  <section class="topics-strip" aria-labelledby="topics-strip-title">
    <div class="section-title-wrap">
      <span class="section-icon" aria-hidden="true">&#127919;</span>
      <h2 id="topics-strip-title" class="strip-label">Explore Math Worlds</h2>
    </div>
    <div class="topics-pills">
      {topics.map((topic) => (
        <a href={`/math/${topic}/`} class="topic-pill">
          <span class="topic-dot" aria-hidden="true">&#9670;</span>
          <span class="topic-name">{topic.replace('-', ' ')}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- All 40 Games Directory: Arcade Quest Grid -->
  <section class="games-directory" aria-labelledby="directory-title">
    <div class="directory-header">
      <div class="directory-title-box">
        <span class="badge-burst" aria-hidden="true">&#128293;</span>
        <div>
          <h2 id="directory-title" class="section-title">All Math Speed Challenges</h2>
          <p class="section-subtitle">Jump into any 10&times;10 grid challenge below!</p>
        </div>
      </div>
      <span class="count-badge">
        <span class="badge-sparkle" aria-hidden="true">&#9733;</span>
        {allGames.length} Challenges Ready
      </span>
    </div>

    <div class="games-grid">
      {allGames.map((game, idx) => (
        <a href={`/math/${game.slug}/`} class={`game-card card-variant-${idx % 4}`}>
          <div class="card-meta">
            <span class="card-grade">Grade {game.grade}</span>
            <span class="card-timer">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {game.game.seconds}s
            </span>
          </div>

          <h3 class="card-title">{game.seo.h1}</h3>
          <p class="card-prompt">{game.game.prompt}</p>

          <div class="card-footer">
            <span class="card-topic">{game.topic.replace('-', ' ')}</span>
            <span class="play-pill">
              <span>Play</span>
              <span class="play-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Teacher Features Banner: Game Master Deck -->
  <section class="teacher-banner">
    <div class="teacher-banner-deco" aria-hidden="true">&#128081;</div>
    <div class="teacher-banner-content">
      <span class="teacher-tag">Teacher &amp; Educator Command Deck</span>
      <h2>Classroom-Ready Tools with Zero Setup</h2>
      <p>
        Zero accounts to create, no lost passwords, and 100% free student access. Instantly beam challenges to Google Classroom, encode multi-game playlist circuits directly in the URL, or print 10&times;10 worksheets with teacher keys.
      </p>
      <div class="teacher-badges">
        <span class="t-badge">&#10003; 1-Click Google Classroom</span>
        <span class="t-badge">&#10003; State-in-URL Playlists</span>
        <span class="t-badge">&#10003; Instant Printable Worksheets</span>
        <span class="t-badge">&#10003; Fullscreen Projector Mode</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    text-align: center;
    padding: 2.5rem 1rem 3rem;
    max-width: 960px;
    margin: 0 auto;
    position: relative;
  }
  
  /* Floating Reward Badges */
  .floating-chips-row {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .hero-chip {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    background: #FFFFFF;
    border: 2px solid #E2E8F0;
    box-shadow: 0 4px 0 #E2E8F0;
    animation: floatChip 4s ease-in-out infinite;
    user-select: none;
  }
  .streak-chip { color: #EA580C; border-color: #FED7AA; box-shadow: 0 4px 0 #FDBA74; animation-delay: 0s; }
  .speed-chip { color: #4F46E5; border-color: #C7D2FE; box-shadow: 0 4px 0 #A5B4FC; animation-delay: 0.8s; }
  .lag-chip { color: #059669; border-color: #A7F3D0; box-shadow: 0 4px 0 #6EE7B7; animation-delay: 1.6s; }
  .free-chip { color: #DB2777; border-color: #FBCFE8; box-shadow: 0 4px 0 #F9A8D4; animation-delay: 2.4s; }

  @keyframes floatChip {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #EEF2FF;
    color: #4338CA;
    border: 2px solid #C7D2FE;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.4rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    box-shadow: 0 3px 0 #C7D2FE;
  }
  .badge-icon {
    font-size: 1rem;
  }

  .hero-headline {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: #0F172A;
    margin: 0 0 1.25rem;
    letter-spacing: -0.025em;
  }
  
  /* Animated Neon Gradient Badge for 60-Second */
  .highlight-badge {
    position: relative;
    display: inline-block;
    padding: 0.15rem 0.75rem;
    background: linear-gradient(135deg, #6366F1 0%, #EC4899 100%);
    color: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 6px 0 #3730A3, 0 12px 24px rgba(99, 102, 241, 0.35);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    transform: rotate(-1.5deg);
    margin: 0 0.25rem;
  }
  .neon-glow {
    position: absolute;
    inset: -3px;
    border-radius: 18px;
    background: linear-gradient(135deg, #818CF8, #F472B6);
    opacity: 0.6;
    filter: blur(8px);
    z-index: -1;
    animation: neonPulse 2.5s ease-in-out infinite alternate;
  }
  @keyframes neonPulse {
    from { opacity: 0.3; transform: scale(0.97); }
    to { opacity: 0.75; transform: scale(1.04); }
  }

  .hero-subhead {
    font-size: 1.25rem;
    color: #CBD5E1;
    line-height: 1.65;
    margin: 0 auto 2.25rem;
    max-width: 760px;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  /* Mascot & Launchpad Area */
  .mascot-launchpad {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }
  .mascot-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }
  .mascot-avatar {
    animation: mascotBounce 3s ease-in-out infinite;
    filter: drop-shadow(0 10px 16px rgba(99, 102, 241, 0.4));
  }
  @keyframes mascotBounce {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
  }
  .mascot-bubble {
    background: #1E1B4B;
    color: #F8FAFC;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.9rem;
    padding: 0.4rem 1rem;
    border-radius: 14px;
    border: 2px solid #6366F1;
    box-shadow: 0 4px 0 #312E81;
    margin-bottom: -6px;
    z-index: 2;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    width: 100%;
  }
  
  /* Giant 3D Arcade Main CTA */
  .cta-primary {
    background: #6366F1;
    color: #FFFFFF;
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 1.15rem 2.4rem;
    border: 2px solid #818CF8;
    border-bottom: 6px solid #3730A3;
    border-radius: 16px;
    box-shadow: 0 10px 25px rgba(99, 102, 241, 0.4);
    transition: transform 0.08s ease, border-bottom-width 0.08s ease, background-color 0.1s ease;
  }
  .cta-primary:hover {
    background: #4F46E5;
    transform: translateY(-2px);
    border-bottom-width: 7px;
  }
  .cta-primary:active {
    transform: translateY(4px);
    border-bottom-width: 2px !important;
    box-shadow: none;
  }
  .play-icon {
    font-size: 1rem;
    color: #FDE047;
  }
  .cta-arrow {
    transition: transform 0.2s ease;
  }
  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-secondary {
    background: #1E293B;
    color: #F8FAFC;
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 1.15rem 2rem;
    border: 2px solid #475569;
    border-bottom: 6px solid #0F172A;
    border-radius: 16px;
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    transition: transform 0.08s ease, border-bottom-width 0.08s ease;
  }
  .cta-secondary:hover {
    background: #334155;
    border-color: #64748B;
    transform: translateY(-2px);
    border-bottom-width: 7px;
  }
  .cta-secondary:active {
    transform: translateY(4px);
    border-bottom-width: 2px !important;
  }

  /* Section Titles */
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .section-icon {
    font-size: 1.35rem;
  }
  .strip-label {
    font-size: 1.35rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0;
  }

  /* Grades Strip: Tactile Station Cards */
  .grades-strip {
    margin: 3rem 0;
  }
  .grades-pills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .grade-card {
    background: #0F172A;
    border: 2px solid #312E81;
    border-bottom: 5px solid #1E1B4B;
    border-radius: 18px;
    padding: 1rem 1.15rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .grade-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 12px 24px rgba(99, 102, 241, 0.25);
    border-color: #6366F1;
    border-bottom-width: 6px;
  }
  .grade-card:active {
    transform: translateY(3px);
    border-bottom-width: 2px !important;
  }
  .grade-badge-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    color: #FFFFFF;
    flex-shrink: 0;
  }
  .grade-color-1 .grade-badge-circle { background: #10B981; box-shadow: 0 4px 0 #059669; }
  .grade-color-2 .grade-badge-circle { background: #06B6D4; box-shadow: 0 4px 0 #0891B2; }
  .grade-color-3 .grade-badge-circle { background: #8B5CF6; box-shadow: 0 4px 0 #6D28D9; }
  .grade-color-4 .grade-badge-circle { background: #EC4899; box-shadow: 0 4px 0 #BE185D; }
  .grade-color-5 .grade-badge-circle { background: #F97316; box-shadow: 0 4px 0 #C2410C; }
  .grade-color-6 .grade-badge-circle { background: #6366F1; box-shadow: 0 4px 0 #4338CA; }
  
  .grade-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .grade-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: #0F172A;
  }
  .grade-count {
    font-size: 0.775rem;
    color: #64748B;
    font-weight: 700;
  }
  .grade-arrow {
    color: #94A3B8;
    font-weight: 700;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .grade-card:hover .grade-arrow {
    color: #4F46E5;
    transform: translateX(4px);
  }

  /* Topics Strip */
  .topics-strip {
    margin: 3rem 0;
  }
  .topics-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .topic-pill {
    background: #1E1B4B;
    border: 2px solid #312E81;
    border-bottom: 5px solid #0F172A;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    color: #E2E8F0;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: capitalize;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    transition: transform 0.08s ease, border-bottom-width 0.08s ease, background-color 0.1s ease;
  }
  .topic-dot {
    font-size: 0.6rem;
    color: #6366F1;
  }
  .topic-pill:hover {
    background: #4F46E5;
    color: #FFFFFF;
    border-color: #6366F1;
    border-bottom-width: 6px;
    transform: translateY(-2px);
  }
  .topic-pill:hover .topic-dot {
    color: #FDE047;
  }
  .topic-pill:active {
    transform: translateY(3px);
    border-bottom-width: 2px !important;
  }

  /* Games Directory & Quest Cards */
  .games-directory {
    margin: 4.5rem 0;
  }
  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .directory-title-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .badge-burst {
    font-size: 1.75rem;
  }
  .section-title {
    font-size: 2.1rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0;
  }
  .section-subtitle {
    margin: 0.2rem 0 0;
    color: #94A3B8;
    font-weight: 600;
    font-size: 1rem;
  }
  .count-badge {
    background: #1E1B4B;
    color: #BAE6FD;
    border: 2px solid #38BDF8;
    border-bottom: 4px solid #0369A1;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    padding: 0.45rem 1rem;
    border-radius: 9999px;
    box-shadow: 0 3px 0 #0369A1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .badge-sparkle {
    color: #F59E0B;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  /* Collectible Arcade Game Cards */
  .game-card {
    background: #0F172A;
    border: 2px solid #312E81;
    border-bottom: 6px solid #1E1B4B;
    border-radius: 20px;
    padding: 1.4rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.12s ease, border-bottom-width 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
    overflow: hidden;
  }
  .game-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, #6366F1, #EC4899, #FACC15);
  }
  .game-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 14px 28px rgba(99, 102, 241, 0.3);
    border-color: #6366F1;
    border-bottom-width: 8px;
  }
  .game-card:active {
    transform: translateY(3px);
    border-bottom-width: 2px !important;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }
  .card-grade {
    background: #312E81;
    color: #C7D2FE;
    border: 2px solid #6366F1;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
  }
  .card-timer {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #451A03;
    color: #FDBA74;
    border: 2px solid #F97316;
    border-radius: 9999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    font-family: var(--font-heading);
    font-weight: 800;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #F8FAFC;
    margin: 0 0 0.45rem;
    line-height: 1.3;
  }
  .card-prompt {
    font-size: 0.95rem;
    color: #94A3B8;
    line-height: 1.5;
    margin: 0 0 1.25rem;
    flex-grow: 1;
    font-weight: 600;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    border-top: 2px dashed #1E293B;
    padding-top: 0.85rem;
  }
  .card-topic {
    text-transform: capitalize;
    color: #A5B4FC;
    font-weight: 800;
    font-size: 0.825rem;
  }
  .play-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #6366F1;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.825rem;
