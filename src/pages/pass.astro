---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Teacher & Parent Pass', url: '/pass/' }
];

const seoTitle = 'Teacher & Parent Pass — Fact Spark ⚡';
const seoDesc = 'Upgrade to Fact Spark Teacher Pass ($3.99/mo or $29/yr). Enjoy 100% ad-free classroom screens, student playlist generator, printable worksheets, and projector warmup mode.';
const canonicalUrl = 'https://gridfluency.com/pass/';

// Only permit mock payment when explicitly running in DEV and PUBLIC_PAYMENT_MODE === 'mock'
const isMockPayment = import.meta.env.DEV && import.meta.env.PUBLIC_PAYMENT_MODE === 'mock';
---

<BaseLayout
  title={seoTitle}
  metaDescription={seoDesc}
  canonicalUrl={canonicalUrl}
  robots="noindex, nofollow"
>
  <Breadcrumbs crumbs={breadcrumbs} />

  <div class="pass-container">
    <header class="pass-hero">
      <span class="pass-pill">Classroom & Home Learning</span>
      <h1 class="pass-h1">The Teacher & Parent Pass</h1>
      <p class="pass-subtitle">
        Empower students with a distraction-free, 100% ad-free math fluency environment. Includes custom classroom playlists, automated worksheet generators, and full-screen projector modes.
      </p>
    </header>

    <!-- Pricing Switcher & Cards -->
    <section class="pricing-section" aria-label="Subscription Plans">
      <div class="billing-toggle-wrapper">
        <span class="toggle-label" id="lbl-monthly">Monthly</span>
        <button
          type="button"
          class="billing-toggle-btn"
          id="billing-toggle"
          role="switch"
          aria-checked="false"
          aria-label="Toggle annual billing discount"
        >
          <span class="toggle-slider"></span>
        </button>
        <span class="toggle-label" id="lbl-annual">
          Annual <span class="savings-tag">Save 39%</span>
        </span>
      </div>

      <div class="plans-grid">
        <!-- Free Tier Card -->
        <div class="plan-card free-card">
          <div class="plan-header">
            <h2 class="plan-name">Community Free</h2>
            <p class="plan-desc">For individual quick practice on public school grids.</p>
            <div class="plan-price">
              <span class="price-val">$0</span>
              <span class="price-period">forever</span>
            </div>
          </div>
          <ul class="features-list">
            <li><span class="check-icon">✓</span> 40+ Interactive 10x10 math fluency games</li>
            <li><span class="check-icon">✓</span> Local browser personal best tracking</li>
            <li><span class="check-icon">✓</span> High-contrast accessibility modes</li>
            <li class="disabled"><span class="cross-icon">✕</span> Compliant child-directed banner ads</li>
            <li class="disabled"><span class="cross-icon">✕</span> Custom playlist generator</li>
            <li class="disabled"><span class="cross-icon">✕</span> Printable PDF worksheets with answer keys</li>
          </ul>
          <a href="/math/" class="btn-plan btn-secondary">Play Free Games</a>
        </div>

        <!-- Teacher Pass Card -->
        <div class="plan-card pass-card featured">
          <div class="popular-ribbon">Most Popular</div>
          <div class="plan-header">
            <h2 class="plan-name">Teacher & Parent Pass</h2>
            <p class="plan-desc">Single-seat license for teachers, tutors, and homeschooling families.</p>
            <div class="plan-price">
              <span class="price-val" id="display-price">$3.99</span>
              <span class="price-period" id="display-period">/ month</span>
            </div>
            <p class="billing-note" id="display-note">Billed monthly. Cancel anytime with 1 click.</p>
          </div>
          <ul class="features-list">
            <li><span class="check-icon">✓</span> <strong>100% Ad-Free:</strong> Zero ad scripts or trackers loaded</li>
            <li><span class="check-icon">✓</span> <strong>Custom Playlists:</strong> Sequence up to 10 games for math centers</li>
            <li><span class="check-icon">✓</span> <strong>Printable Worksheets:</strong> Instant PDFs with teacher answer keys</li>
            <li><span class="check-icon">✓</span> <strong>Projector Warmup Mode:</strong> Oversized tiles for interactive whiteboards</li>
            <li><span class="check-icon">✓</span> <strong>Google Classroom Export:</strong> 1-click student assignment links</li>
            <li><span class="check-icon">✓</span> <strong>Multi-device access:</strong> Works across all classroom Chromebooks</li>
          </ul>
          <button
            type="button"
            class="btn-plan btn-primary"
            id="btn-subscribe"
            data-plan="monthly"
            disabled={!isMockPayment ? true : undefined}
          >
            {isMockPayment ? 'Start Distraction-Free Pass' : 'Coming soon'}
          </button>
        </div>
      </div>
    </section>

    <!-- Transparent Policy & Ethical Billing -->
    <section class="ethics-section">
      <div class="ethics-box">
        <h3>🛡️ Transparent & Ethical Billing Policy</h3>
        <p>
          We know teachers and parents despise hidden auto-renew traps. You can cancel your subscription at any time with a single click inside your account portal. Upon cancellation, your license remains fully active until the end of your prepaid billing period. No phone calls, no dark patterns, no hassle.
        </p>
      </div>
    </section>

    <!-- Comparison Table -->
    <section class="comparison-section">
      <h2 class="comp-title">Feature Comparison</h2>
      <div class="table-container">
        <table class="comp-table">
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col">Free Community</th>
              <th scope="col" class="highlight-col">Teacher & Parent Pass</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Display Ads</td>
              <td>Child-friendly non-personalized ads</td>
              <td class="highlight-col font-bold">100% Ad-Free (Zero Scripts)</td>
            </tr>
            <tr>
              <td>Printable Worksheets & Answer Keys</td>
              <td>Sample only</td>
              <td class="highlight-col font-bold">Unlimited Instant Prints</td>
            </tr>
            <tr>
              <td>Classroom Playlists & Math Centers</td>
              <td>None</td>
              <td class="highlight-col font-bold">Unlimited Custom Playlists</td>
            </tr>
            <tr>
              <td>Smartboard Projector Mode</td>
              <td>Standard</td>
              <td class="highlight-col font-bold">High-Contrast Whiteboard Optimized</td>
            </tr>
            <tr>
              <td>Google Classroom & LMS Share</td>
              <td>Standard URL</td>
              <td class="highlight-col font-bold">Direct Deep Links with Prefill</td>
            </tr>
            <tr>
              <td>Student Data Privacy</td>
              <td>We don't collect personal information from students.</td>
              <td class="highlight-col font-bold">We don't collect personal information from students. (Zero Ad Footprint)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="pass-faq">
      <h2 class="comp-title">Frequently Asked Questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Can my entire classroom use my Teacher Pass?</summary>
          <p>Yes! When you log in on your teacher laptop or display board, your student devices can access the shared playlist link or pass session on classroom Chromebooks without student accounts or passwords.</p>
        </details>
        <details class="faq-item">
          <summary>How does the cancellation process work?</summary>
          <p>You can cancel in seconds from your Stripe billing email or account link. You will retain full access until the end of your billing cycle.</p>
        </details>
        <details class="faq-item">
          <summary>Can my school pay via Purchase Order (PO)?</summary>
          <p>For school-wide or district licenses (10+ teachers), please contact schools@gridfluency.com for customized invoicing and vendor onboarding.</p>
        </details>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const toggle = document.getElementById('billing-toggle') as HTMLButtonElement | null;
  const displayPrice = document.getElementById('display-price');
  const displayPeriod = document.getElementById('display-period');
  const displayNote = document.getElementById('display-note');
  const btnSubscribe = document.getElementById('btn-subscribe') as HTMLButtonElement | null;

  // Strict check: Mock payment provider is only reachable in DEV when PUBLIC_PAYMENT_MODE === 'mock'
  const isMockPayment = import.meta.env.DEV && import.meta.env.PUBLIC_PAYMENT_MODE === 'mock';

  let isAnnual = false;

  function updatePlanDisplay() {
    if (!displayPrice || !displayPeriod || !displayNote || !btnSubscribe || !toggle) return;

    if (!isMockPayment) {
      btnSubscribe.textContent = 'Coming soon';
      btnSubscribe.disabled = true;
      if (isAnnual) {
        toggle.setAttribute('aria-checked', 'true');
        toggle.classList.add('active');
        displayPrice.textContent = '$29';
        displayPeriod.textContent = '/ year';
        displayNote.textContent = 'Billed annually ($2.42/mo). Save $18.88 per year.';
        btnSubscribe.dataset.plan = 'annual';
      } else {
        toggle.setAttribute('aria-checked', 'false');
        toggle.classList.remove('active');
        displayPrice.textContent = '$3.99';
        displayPeriod.textContent = '/ month';
        displayNote.textContent = 'Billed monthly. Cancel anytime with 1 click.';
        btnSubscribe.dataset.plan = 'monthly';
      }
      return;
    }

    if (isAnnual) {
      toggle.setAttribute('aria-checked', 'true');
      toggle.classList.add('active');
      displayPrice.textContent = '$29';
      displayPeriod.textContent = '/ year';
      displayNote.textContent = 'Billed annually ($2.42/mo). Save $18.88 per year.';
      btnSubscribe.dataset.plan = 'annual';
      btnSubscribe.textContent = 'Start Annual Pass ($29/yr)';
    } else {
      toggle.setAttribute('aria-checked', 'false');
      toggle.classList.remove('active');
      displayPrice.textContent = '$3.99';
      displayPeriod.textContent = '/ month';
      displayNote.textContent = 'Billed monthly. Cancel anytime with 1 click.';
      btnSubscribe.dataset.plan = 'monthly';
      btnSubscribe.textContent = 'Start Distraction-Free Pass ($3.99/mo)';
    }
  }

  // In production, ensure the Buy button shows "Coming soon", is disabled, and does nothing else
  if (!isMockPayment && btnSubscribe) {
    btnSubscribe.textContent = 'Coming soon';
    btnSubscribe.disabled = true;
  }

  toggle?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    updatePlanDisplay();
  });

  if (isMockPayment && btnSubscribe) {
    btnSubscribe.addEventListener('click', async () => {
      const plan = btnSubscribe.dataset.plan || 'monthly';
      btnSubscribe.disabled = true;
      btnSubscribe.textContent = 'Opening Secure Checkout...';

      try {
        const res = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan })
        });

        if (res.ok) {
          const data = await res.json();
          if (data.url) {
            window.location.href = data.url;
            return;
          }
        }
      } catch {
        // Offline or mock environment fallback
      }

      // Dev mock fallback only
      window.location.href = `/pass/success?demo=true&plan=${plan}`;
    });
  }
</script>

<style>
  .pass-container {
    max-width: 1000px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
  }

  .pass-hero {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .pass-pill {
    display: inline-block;
    padding: 0.35rem 1.15rem;
    background: #E1E0FF;
    color: #07006C;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #0F172A;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.85rem;
    font-family: var(--font-caps);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .pass-h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 900;
    color: #0F172A;
    margin-bottom: 1rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .pass-subtitle {
    font-size: 1.15rem;
    color: #464554;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
    font-weight: 500;
  }

  /* Billing Toggle */
  .billing-toggle-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .toggle-label {
    font-size: 1rem;
    font-weight: 800;
    color: #0F172A;
    font-family: var(--font-heading);
  }

  .savings-tag {
    background: #6BFF8F;
    color: #002109;
    font-family: var(--font-caps);
    font-size: 0.775rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 8px;
    margin-left: 0.4rem;
    border: 1.5px solid #0F172A;
  }

  .billing-toggle-btn {
    width: 62px;
    height: 34px;
    background: #F2F3FF;
    border-radius: 9999px;
    border: 2px solid #0F172A;
    position: relative;
    cursor: pointer;
    padding: 2px;
    box-shadow: 0 3px 0 0 #0F172A;
    transition: background 0.15s ease;
  }

  .billing-toggle-btn.active {
    background: #4648D4;
  }

  .toggle-slider {
    display: block;
    width: 26px;
    height: 26px;
    background: #FFFFFF;
    border: 1.5px solid #0F172A;
    border-radius: 50%;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .billing-toggle-btn.active .toggle-slider {
    transform: translateX(28px);
  }

  /* Plans Grid */
  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.25rem;
    align-items: stretch;
    margin-bottom: 4rem;
  }

  .plan-card {
    background: #FFFFFF;
    border: 2px solid #0F172A;
    border-radius: 26px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 6px 0 0 #0F172A;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }

  .plan-card.featured {
    border: 3px solid #0F172A;
    box-shadow: 0 8px 0 0 #0F172A;
  }
  .plan-card.featured:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 0 0 #0F172A;
  }

  .popular-ribbon {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    background: #FFC329;
    color: #6F5100;
    font-family: var(--font-caps);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.4rem 1.4rem;
    border-radius: 12px;
    border: 2px solid #0F172A;
    box-shadow: 0 3px 0 0 #795900;
  }

  .plan-header {
    text-align: center;
    border-bottom: 2px dashed #C7C4D7;
    padding-bottom: 1.75rem;
    margin-bottom: 1.75rem;
  }

  .plan-name {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
    color: #0F172A;
    margin-bottom: 0.5rem;
    letter-spacing: -0.015em;
  }

  .plan-desc {
    font-size: 0.95rem;
    color: #464554;
    margin-bottom: 1.25rem;
    min-height: 2.5rem;
    font-weight: 500;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem;
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 3.25rem;
    font-weight: 900;
    color: #0F172A;
    font-variant-numeric: tabular-nums;
  }

  .price-period {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    color: #464554;
    font-weight: 700;
  }

  .billing-note {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: #00873B;
    font-weight: 800;
    margin-top: 0.5rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2.25rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.95rem;
    color: #131B2E;
    font-weight: 500;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.5;
  }

  .features-list li.disabled {
    color: #767586;
    text-decoration: line-through;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #6BFF8F;
    color: #002109;
    border: 1.5px solid #0F172A;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .cross-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #FFDAD6;
    color: #93000A;
    border: 1.5px solid #0F172A;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .btn-plan {
    display: block;
    width: 100%;
    padding: 1.05rem;
    border-radius: 14px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid #0F172A;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  .btn-plan:disabled,
  .btn-plan[disabled] {
    opacity: 0.65;
    cursor: not-allowed;
    background: #E2E8F0 !important;
    color: #464554 !important;
    box-shadow: 0 3px 0 0 #0F172A !important;
    transform: none !important;
  }

  .btn-primary {
    background: #22C55E;
    color: #FFFFFF;
    box-shadow: 0 4px 0 0 #15803D;
  }
  .btn-primary:hover:not(:disabled) {
    background: #16A34A;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 0 #15803D;
  }
  .btn-primary:active:not(:disabled) {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #15803D;
  }

  .btn-secondary {
    background: #FFFFFF;
    color: #0F172A;
    box-shadow: 0 4px 0 0 #0F172A;
  }
  .btn-secondary:hover {
    background: #F2F3FF;
    color: #4648D4;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 0 #0F172A;
  }
  .btn-secondary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #0F172A;
  }

  /* Ethics Box */
  .ethics-section {
    margin-bottom: 4rem;
  }

  .ethics-box {
    background: #F2F3FF;
    border: 2px solid #0F172A;
    border-radius: 20px;
    padding: 2rem 2.25rem;
    box-shadow: 0 6px 0 0 #0F172A;
  }

  .ethics-box h3 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    color: #07006C;
    margin-bottom: 0.65rem;
    letter-spacing: -0.015em;
  }

  .ethics-box p {
    font-size: 1rem;
    color: #131B2E;
    line-height: 1.65;
    margin: 0;
    font-weight: 500;
  }

  /* Comparison Table */
  .comparison-section {
    margin-bottom: 4rem;
  }

  .comp-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 900;
    color: #0F172A;
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  .table-container {
    overflow-x: auto;
    border-radius: 20px;
    border: 2px solid #0F172A;
    box-shadow: 0 6px 0 0 #0F172A;
    background: #FFFFFF;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 1rem;
    background: #FFFFFF;
    color: #131B2E;
  }

  .comp-table th,
  .comp-table td {
    padding: 1.15rem 1.4rem;
    border-bottom: 1.5px solid #C7C4D7;
  }

  .comp-table th {
    background: #F2F3FF;
    font-family: var(--font-heading);
    font-weight: 800;
    color: #0F172A;
  }

  .highlight-col {
    background: #EAEDFF;
  }

  .font-bold {
    font-weight: 800;
    color: #4648D4;
  }

  /* FAQ */
  .pass-faq {
    margin-bottom: 3rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq-item {
    border: 2px solid #0F172A;
    border-radius: 18px;
    padding: 1.15rem 1.4rem;
    background: #FFFFFF;
    box-shadow: 0 4px 0 0 #0F172A;
  }

  .faq-item summary {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    color: #0F172A;
    cursor: pointer;
  }

  .faq-item p {
    margin-top: 0.85rem;
    font-size: 1rem;
    color: #464554;
    line-height: 1.6;
    font-weight: 500;
  }
</style>
