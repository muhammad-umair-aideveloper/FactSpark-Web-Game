---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Teacher Pass', url: '/pass/' },
  { name: 'Order Success', url: '/pass/success/' }
];
---

<BaseLayout
  title="Teacher Pass Activated — Grid Fluency"
  metaDescription="Your Teacher Pass has been activated. Enjoy 100% ad-free math fluency across all classroom screens."
  canonicalUrl="https://gridfluency.com/pass/success/"
  robots="noindex, nofollow"
>
  <Breadcrumbs crumbs={breadcrumbs} />

  <div class="success-card">
    <div class="success-icon">🎉</div>
    <h1 class="success-title">Teacher Pass Activated!</h1>
    <p class="success-lead">
      Thank you for supporting distraction-free math learning! Your classroom license is now verified and active.
    </p>

    <div class="license-badge-box">
      <div class="badge-row">
        <span class="badge-lbl">License Status</span>
        <strong class="badge-val status-active">● Active & Verified</strong>
      </div>
      <div class="badge-row">
        <span class="badge-lbl">Ad Filter</span>
        <strong class="badge-val">100% Ad-Free (Zero Third-Party Scripts)</strong>
      </div>
      <div class="badge-row">
        <span class="badge-lbl">Classroom Tools</span>
        <strong class="badge-val">Playlists, Worksheets & Projector Mode Enabled</strong>
      </div>
    </div>

    <div class="success-actions">
      <a href="/math/" class="btn-primary">Browse All 40+ Math Games</a>
      <a href="/playlist/" class="btn-secondary">Build a Classroom Playlist</a>
    </div>

    <p class="cancel-reminder">
      Need to manage billing? A direct link to your Stripe customer portal has been sent to your email. You can cancel at any time with 1 click.
    </p>
  </div>
</BaseLayout>

<script>
  import { activateLicense, hasActiveLicense } from '../../license';

  const isMockPayment = import.meta.env.DEV && import.meta.env.PUBLIC_PAYMENT_MODE === 'mock';
  const params = new URLSearchParams(window.location.search);
  const token = params.get('token');
  const isDemo = params.get('demo') === 'true';
  const plan = params.get('plan') === 'annual' ? 'annual' : 'monthly';

  const statusBadge = document.querySelector('.status-active') as HTMLElement | null;
  const cardTitle = document.querySelector('.success-title') as HTMLElement | null;
  const leadText = document.querySelector('.success-lead') as HTMLElement | null;

  function showVerificationFailed(msg: string) {
    if (statusBadge) {
      statusBadge.textContent = '● Verification Required';
      statusBadge.classList.remove('status-active');
      statusBadge.style.color = '#EF4444';
    }
    if (cardTitle) {
      cardTitle.textContent = 'License Not Verified';
    }
    if (leadText) {
      leadText.textContent = msg;
    }
  }

  async function processActivation() {
    if (token) {
      // Must cryptographically verify signature against Worker before granting license
      try {
        const res = await fetch(`/api/verify-license?token=${encodeURIComponent(token)}`);
        if (res.ok) {
          const data = await res.json();
          if (data && data.valid) {
            activateLicense(token);
            return;
          }
        }
        showVerificationFailed('The provided license token failed cryptographic verification by the license server.');
      } catch {
        showVerificationFailed('Unable to reach the license verification service to validate token authenticity.');
      }
    } else if (isMockPayment && isDemo && !hasActiveLicense()) {
      // Gated exclusively to dev environment with PUBLIC_PAYMENT_MODE=mock
      const exp = Math.floor(Date.now() / 1000) + (plan === 'annual' ? 86400 * 365 : 86400 * 30);
      const headerB64 = btoa(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
      const payloadB64 = btoa(JSON.stringify({
        email: 'demo-teacher@gridfluency.com',
        plan,
        iat: Math.floor(Date.now() / 1000),
        exp
      }));
      const mockSig = 'demo_verified_sig_987654';
      activateLicense(`${headerB64}.${payloadB64}.${mockSig}`);
    } else if (!hasActiveLicense()) {
      showVerificationFailed('No verified signed license token was provided. Access requires an authenticated purchase confirmation.');
    }
  }

  processActivation();
</script>

<style>
  .success-card {
    max-width: 680px;
    margin: 3rem auto 5rem;
    padding: 3.5rem 2.25rem;
    background: #FFFFFF;
    border: 3.5px solid #10B981;
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 10px 0 #047857, 0 25px 45px rgba(16, 185, 129, 0.2);
  }

  .success-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
    animation: iconBounce 2s ease-in-out infinite;
  }
  @keyframes iconBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .success-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.75rem;
  }

  .success-lead {
    font-size: 1.15rem;
    color: #475569;
    margin-bottom: 2rem;
    line-height: 1.6;
    font-weight: 600;
  }

  .license-badge-box {
    background: #F8FAFC;
    border: 2px solid #E2E8F0;
    border-radius: 18px;
    padding: 1.75rem;
    margin-bottom: 2.25rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    gap: 1rem;
  }

  .badge-lbl {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #64748B;
  }

  .badge-val {
    color: #0F172A;
    font-weight: 700;
  }

  .status-active {
    color: #10B981;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .success-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 16px;
    border: 2px solid #3730A3;
    text-decoration: none;
    box-shadow: 0 5px 0 #3730A3;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .btn-primary:hover {
    background: #4338CA;
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #3730A3;
  }
  .btn-primary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #3730A3;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: #FFFFFF;
    color: #1E293B;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 16px;
    border: 2px solid #CBD5E1;
    text-decoration: none;
    box-shadow: 0 4px 0 #CBD5E1;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .btn-secondary:hover {
    background: #F8FAFC;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #94A3B8;
  }
  .btn-secondary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #CBD5E1;
  }

  .cancel-reminder {
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.5;
    margin: 0;
    font-weight: 600;
  }
</style>
