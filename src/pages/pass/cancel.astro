---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Teacher Pass', url: '/pass/' },
  { name: 'Checkout Cancelled', url: '/pass/cancel/' }
];
---

<BaseLayout
  title="Checkout Cancelled — Fact Spark ⚡"
  metaDescription="Your checkout session was cancelled. No charges were made. You can still enjoy all 40+ free math games."
  canonicalUrl="https://gridfluency.com/pass/cancel/"
  robots="noindex, nofollow"
>
  <Breadcrumbs crumbs={breadcrumbs} />

  <div class="cancel-card">
    <div class="cancel-icon">↩️</div>
    <h1 class="cancel-title">Checkout Cancelled</h1>
    <p class="cancel-lead">
      No charges were made to your card. Whenever you are ready to upgrade your classroom to 100% ad-free screens, the Teacher Pass will be waiting for you.
    </p>

    <div class="cancel-actions">
      <a href="/pass/" class="btn-primary">View Pricing Plans</a>
      <a href="/math/" class="btn-secondary">Play Free Math Games</a>
    </div>
  </div>
</BaseLayout>

<style>
  .cancel-card {
    max-width: 620px;
    margin: 4rem auto 6rem;
    padding: 3.5rem 2.25rem;
    background: #FFFFFF;
    border: 3px solid #0F172A;
    border-radius: 28px;
    text-align: center;
    box-shadow: 0 8px 0 0 #0F172A;
  }

  .cancel-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .cancel-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 900;
    color: #0F172A;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .cancel-lead {
    font-size: 1.15rem;
    color: #464554;
    margin-bottom: 2rem;
    line-height: 1.6;
    font-weight: 500;
  }

  .cancel-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: #4648D4;
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 16px;
    border: 2px solid #0F172A;
    text-decoration: none;
    box-shadow: 0 4px 0 0 #2F2EBE;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }

  .btn-primary:hover {
    background: #3537B8;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 0 #2F2EBE;
  }
  .btn-primary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #2F2EBE;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: #FFFFFF;
    color: #0F172A;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    border-radius: 16px;
    border: 2px solid #0F172A;
    text-decoration: none;
    box-shadow: 0 4px 0 0 #0F172A;
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }

  .btn-secondary:hover {
    background: #F2F3FF;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 0 #0F172A;
  }
  .btn-secondary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #0F172A;
  }
</style>
