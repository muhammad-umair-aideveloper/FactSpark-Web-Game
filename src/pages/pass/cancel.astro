---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Teacher Pass', url: '/pass/' },
  { name: 'Checkout Cancelled', url: '/pass/cancel/' }
];
---

<BaseLayout
  title="Checkout Cancelled — Grid Fluency"
  metaDescription="Your checkout session was cancelled. No charges were made. You can still enjoy all 40+ free math games."
  canonicalUrl="https://gridfluency.com/pass/cancel/"
  robots="noindex, nofollow"
>
  <Breadcrumbs crumbs={breadcrumbs} />

  <div class="cancel-card">
    <div class="cancel-icon">↩️</div>
    <h1 class="cancel-title">Checkout Cancelled</h1>
    <p class="cancel-lead">
      No charges were made to your card. Whenever you are ready to upgrade your classroom to 100% ad-free screens, the Teacher Pass will be waiting for you.
    </p>

    <div class="cancel-actions">
      <a href="/pass/" class="btn-primary">View Pricing Plans</a>
      <a href="/math/" class="btn-secondary">Play Free Math Games</a>
    </div>
  </div>
</BaseLayout>

<style>
  .cancel-card {
    max-width: 620px;
    margin: 4rem auto 6rem;
    padding: 3.5rem 2.25rem;
    background: #FFFFFF;
    border: 2.5px solid #CBD5E1;
    border-radius: 26px;
    text-align: center;
    box-shadow: 0 8px 0 #CBD5E1, 0 16px 30px rgba(15, 23, 42, 0.05);
  }

  .cancel-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .cancel-title {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 0.75rem;
  }

  .cancel-lead {
    font-size: 1.15rem;
    color: #475569;
    margin-bottom: 2rem;
    line-height: 1.6;
    font-weight: 600;
  }

  .cancel-actions {
    display: flex;
    gap: 1.25rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%);
    color: #FFFFFF;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 16px;
    border: 2px solid #3730A3;
    text-decoration: none;
    box-shadow: 0 5px 0 #3730A3;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .btn-primary:hover {
    background: #4338CA;
    transform: translateY(-2px);
    box-shadow: 0 7px 0 #3730A3;
  }
  .btn-primary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #3730A3;
  }

  .btn-secondary {
    display: inline-block;
    padding: 0.95rem 1.85rem;
    background: #FFFFFF;
    color: #1E293B;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 16px;
    border: 2px solid #CBD5E1;
    text-decoration: none;
    box-shadow: 0 4px 0 #CBD5E1;
    transition: transform 0.12s, box-shadow 0.12s;
  }

  .btn-secondary:hover {
    background: #F8FAFC;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 #94A3B8;
  }
  .btn-secondary:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #CBD5E1;
  }
</style>
