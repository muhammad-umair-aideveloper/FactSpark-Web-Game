---
import HubLayout from '../../layouts/HubLayout.astro';
import { getAllGames } from '../../contentLoader';

const allGames = getAllGames().sort((a, b) => a.grade - b.grade || a.slug.localeCompare(b.slug));

const canonicalUrl = 'https://gridfluency.com/math/';
const title = 'Math Fluency Games Catalog — 10x10 Speed Grids for Grades 1–6';
const metaDescription = `Browse all ${allGames.length} interactive 10x10 math fluency games organized by grade and topic. Master multiplication facts, primes, fractions, and number sense.`;
const h1 = 'Math Fluency Games Catalog';
const intro = `Welcome to the full Grid Fluency game library. Practice rapid number recognition, multiplication facts, fraction equivalence, and number sense on fast-paced 10x10 grid challenges designed for classroom Chromebooks.`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Math Games', url: canonicalUrl }
];
---

<HubLayout
  title={title}
  metaDescription={metaDescription}
  h1={h1}
  intro={intro}
  canonicalUrl={canonicalUrl}
  games={allGames}
  breadcrumbs={breadcrumbs}
/>
